// 铲子解锁：通关 1-3 后自动解锁
function isShovelUnlocked() {
    return typeof saveData !== 'undefined' && saveData && saveData.cleared && saveData.cleared.includes('1-3');
}

// ---------- 武器碎片 · 掉落权重（决定僵尸倾向掉哪种）----------
// 权重和不必为100，纯相对权重。
const WEAPON_FRAG_WEIGHTS = {
    normal:  { pistol: 45, dagger: 40, shotgun: 10, sword: 5 },
    cone:    { pistol: 30, dagger: 25, shotgun: 30, sword: 15 },
    bucket:  { pistol: 15, dagger: 15, shotgun: 35, sword: 35 },
    spitter: { pistol: 50, dagger: 15, shotgun: 25, sword: 10 },
};
function pickWeightedWeaponFrag(zombieKind) {
    const w = WEAPON_FRAG_WEIGHTS[zombieKind] || WEAPON_FRAG_WEIGHTS.normal;
    let total = 0;
    for (const k in w) total += w[k];
    let r = Math.random() * total;
    for (const k in w) { r -= w[k]; if (r <= 0) return k; }
    return 'pistol';
}

// ---------- 武器解锁与升级表 ----------
// 每把武器：解锁需要 N 片；等级 1..MAX，每级消耗 cost 碎片，提升 mul(伤害/攻速倍率简单叠)。
// 每把武器 baseDurability = 局内出场耐久上限；等级提升会加耐久
const WEAPON_META = {
    pistol:  { fragKey: 'pistol',  fragLabel: '枪片', unlockCost: 15, maxLevel: 5, perLevel: 15, baseDurability: 40 },
    shotgun: { fragKey: 'shotgun', fragLabel: '壳片', unlockCost: 25, maxLevel: 5, perLevel: 20, baseDurability: 20 },
    dagger:  { fragKey: 'dagger',  fragLabel: '匕片', unlockCost: 10, maxLevel: 5, perLevel: 10, baseDurability: 30 },
    sword:   { fragKey: 'sword',   fragLabel: '剑片', unlockCost: 20, maxLevel: 5, perLevel: 18, baseDurability: 22 },
};
const WEAPON_ORDER = ['pistol', 'shotgun', 'dagger', 'sword']; // 图鉴顺序
// 每级伤害/攻速倍率
const WEAPON_LEVEL_MUL = [1.00, 1.15, 1.30, 1.50, 1.75, 2.00]; // idx = lv

function weaponMul(lv)   { return WEAPON_LEVEL_MUL[Math.max(1, Math.min(lv, WEAPON_LEVEL_MUL.length - 1))]; }
function weaponDurCap(k, lv) {
    const m = WEAPON_META[k]; if (!m) return 0;
    // 等级越高耐久越多（每级 +20%）
    return Math.round(m.baseDurability * (1 + (lv - 1) * 0.2));
}

// ---------- 武器存储 ----------
function loadWeapons() {
    try {
        const raw = JSON.parse(localStorage.getItem(WEAPON_STORAGE_KEY)) || {};
        return {
            unlocked: raw.unlocked || {},   // { pistol: true, ... }
            levels:   raw.levels   || {},   // { pistol: 1, ... }
            equipped: raw.equipped || null, // 当前携带武器 key
        };
    } catch {
        return { unlocked: {}, levels: {}, equipped: null };
    }
}
function saveWeapons() {
    try { localStorage.setItem(WEAPON_STORAGE_KEY, JSON.stringify(META.weapons)); } catch {}
}
function loadWeaponFrags() {
    try { return JSON.parse(localStorage.getItem(WFRAG_STORAGE_KEY)) || {}; }
    catch { return {}; }
}
function saveWeaponFrags() {
    try { localStorage.setItem(WFRAG_STORAGE_KEY, JSON.stringify(META.weaponFrags)); } catch {}
}

