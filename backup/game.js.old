// 僵尸类型 → 碎片权重表（所有僵尸都会掉，但侧重不同植物）
const ZOMBIE_FRAG_WEIGHTS = {
    normal:  { sunflower: 40, peashooter: 40, wallnut: 15, cherry: 5 },
    cone:    { sunflower: 30, peashooter: 30, wallnut: 25, cherry: 15 },
    bucket:  { sunflower: 20, peashooter: 25, wallnut: 25, cherry: 30 },
    spitter: { sunflower: 25, peashooter: 35, wallnut: 20, cherry: 20 },
};

// 按权重随机抽一个植物 kind
function pickWeightedFragment(zombieKind) {
    const w = ZOMBIE_FRAG_WEIGHTS[zombieKind] || ZOMBIE_FRAG_WEIGHTS.normal;
    let total = 0;
    for (const k in w) total += w[k];
    let r = Math.random() * total;
    for (const k in w) {
        r -= w[k];
        if (r <= 0) return k;
    }
    return 'peashooter';
}

