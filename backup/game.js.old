// 局外存档：通关记录、当前关卡
function loadSave() {
    try {
        return JSON.parse(localStorage.getItem(SAVE_KEY)) || { cleared: [], lastLevel: null };
    } catch {
        return { cleared: [], lastLevel: null };
    }
}
function writeSave(s) {
    try { localStorage.setItem(SAVE_KEY, JSON.stringify(s)); } catch {}
}
const saveData = loadSave();

