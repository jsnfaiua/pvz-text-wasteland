// ---------- 局外碎片存储（PvZ2 风格升级）----------
// 通过 Net.storeKey 让每个账户拥有独立命名空间；未登录时走 __guest__
const _K = (base) => (window.Net ? Net.storeKey(base) : base);
const FRAG_STORAGE_KEY   = _K('pvz_txt_fragments_v1');
const LEVEL_STORAGE_KEY  = _K('pvz_txt_levels_v1');
const CURRENCY_KEY       = _K('pvz_txt_currency_v1');
const WEAPON_STORAGE_KEY = _K('pvz_txt_weapons_v1');
const WFRAG_STORAGE_KEY  = _K('pvz_txt_wfrags_v1');
const SAVE_KEY           = _K('pvz_txt_save_v1');

function loadFragments() {
    try { return JSON.parse(localStorage.getItem(FRAG_STORAGE_KEY)) || {}; }
    catch { return {}; }
}
function saveFragments(obj) {
    try { localStorage.setItem(FRAG_STORAGE_KEY, JSON.stringify(obj)); } catch {}
}
function loadLevels() {
    try {
        const raw = JSON.parse(localStorage.getItem(LEVEL_STORAGE_KEY)) || {};
        CARD_ORDER.forEach(k => { if (raw[k] == null) raw[k] = 1; });
        return raw;
    } catch {
        return CARD_ORDER.reduce((o, k) => (o[k] = 1, o), {});
    }
}
function saveLevels(obj) {
    try { localStorage.setItem(LEVEL_STORAGE_KEY, JSON.stringify(obj)); } catch {}
}

// PvZ2 风格等级表：累计碎片阈值 + 属性倍率
const LEVEL_TABLE = [
    { lv: 1, cumulative: 0,   mul: 1.00, label: 'Lv1' },
    { lv: 2, cumulative: 10,  mul: 1.15, label: 'Lv2' },
    { lv: 3, cumulative: 30,  mul: 1.30, label: 'Lv3' },
    { lv: 4, cumulative: 80,  mul: 1.50, label: 'Lv4' },
    { lv: 5, cumulative: 200, mul: 2.00, label: 'Lv5 觉醒' },
];
function levelInfo(lv) {
    return LEVEL_TABLE.find(x => x.lv === lv) || LEVEL_TABLE[0];
}
function nextLevelInfo(lv) {
    return LEVEL_TABLE.find(x => x.lv === lv + 1);
}

// 全局：局外持久数据
const META = {
    fragments: loadFragments(),
    levels: loadLevels(),
    currency: loadCurrency(),   // { silver, gold, gem }
    weapons: loadWeapons(),     // { unlocked, levels, equipped }
    weaponFrags: loadWeaponFrags(), // { pistol: 5, ... }
};

// ---------- 货币系统 ----------
function loadCurrency() {
    try {
        const raw = JSON.parse(localStorage.getItem(CURRENCY_KEY)) || {};
        return {
            silver: raw.silver || 0,
            gold:   raw.gold   || 0,
            gem:    raw.gem    || 0,
        };
    } catch {
        return { silver: 0, gold: 0, gem: 0 };
    }
}
function saveCurrency() {
    try { localStorage.setItem(CURRENCY_KEY, JSON.stringify(META.currency)); } catch {}
}
function addCurrency(type, amount) {
    if (!META.currency[type]) META.currency[type] = 0;
    META.currency[type] += amount;
    saveCurrency();
    refreshCurrencyUI();
}
function refreshCurrencyUI() {
    ['cur-silver-lv', 'cur-silver-shop', 'cur-silver-game', 'cur-silver-armory'].forEach(id => {
        const el = document.getElementById(id);
        if (el) el.textContent = META.currency.silver || 0;
    });
    ['cur-gold-lv', 'cur-gold-shop', 'cur-gold-game', 'cur-gold-armory'].forEach(id => {
        const el = document.getElementById(id);
        if (el) el.textContent = META.currency.gold || 0;
    });
    ['cur-gem-lv', 'cur-gem-shop', 'cur-gem-game', 'cur-gem-armory'].forEach(id => {
        const el = document.getElementById(id);
        if (el) el.textContent = META.currency.gem || 0;
    });
}

// 每种植物在升级时对哪个字段生效
const PLANT_LEVEL_STAT = {
    sunflower:  { field: 'produceRate', label: '产阳光速度', base: 24, invert: true },  // 周期越短越好
    peashooter: { field: 'damage',      label: '豌豆伤害',    base: 20 },
    wallnut:    { field: 'hp',          label: '血量',        base: 4000 },
    cherry:     { field: 'radius',      label: '爆炸半径',    base: 130 },
};

// 获取植物某属性的当前等级增益值
function getPlantStat(kind) {
    const lv = META.levels[kind] || 1;
    const mul = levelInfo(lv).mul;
    const spec = PLANT_LEVEL_STAT[kind];
    if (!spec) return { lv, mul, value: 0 };
    const value = spec.invert ? spec.base / mul : spec.base * mul;
    return { lv, mul, value };
}

