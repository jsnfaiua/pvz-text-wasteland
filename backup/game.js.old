    spawnTimer: 1,
    naturalSunTimer: 8,
    gameOver: false,
    victory: false,
    time: 0,
    killedTotal: 0,     // 全关累计击杀（用于进度条）
    // 联机（房主）持有远端玩家状态；客人仅从 snapshot 反序列化
    mp: {
        active: false,
        role: null,           // 'host' | 'guest'
        remoteInput: null,    // 房主端：最近一次收到的客人输入
        snapshotAcc: 0,       // 房主端：广播定时累计
    },
};
// 第二玩家（远端）—— 房主端跟踪，客人端从 snapshot 覆盖
const dave2 = {
    x: 0, y: 0, jumpOffset: 0,
    hp: 3, hurtFlash: 0,
    facing: 1, facingAngle: 0,
    color: '#66FFCC',
    label: 'P2',
    isJumping: false, vy: 0, jumpCooldown: 0,
    weaponCooldown: 0,
    swingTimer: 0, swingDir: 0, swingWeapon: null,
    dashing: false, dashTimer: 0, dashCooldown: 0,
    guarding: false, guardTimer: 0, guardCooldown: 0,
    invuln: 0, perfectFlash: 0, guardFacing: 0,
    sprinting: false,
    currentWeapon: null,
    equippedWeapon: null, equippedLevel: 1, equippedDurability: 0,
    _damageAcc: 0,
    get row() { return yToRow(this.y); },
};
CARD_ORDER.forEach(k => state.cooldowns[k] = 0);

// ---------- DOM 引用 ----------
const sunValueEl = document.getElementById('sun-value');
const waveValueEl = document.getElementById('wave-value');
const hpValueEl = document.getElementById('hp-value');
const heroNameEl = document.getElementById('hero-name');
const logEl = document.getElementById('log-text');
const cardEls = Array.from(document.querySelectorAll('#card-slots .card'));

// 主角改名
heroNameEl.addEventListener('input', () => {
    const v = heroNameEl.value.trim();
    dave.label = v.length > 0 ? v : '戴夫';
});
let inputFocused = false;
heroNameEl.addEventListener('focus', () => { inputFocused = true; });
heroNameEl.addEventListener('blur', () => { inputFocused = false; });

// 卡槽点击
cardEls.forEach((el, idx) => {
    el.addEventListener('click', () => selectCard(idx));
});

// ---------- 日志 ----------
let logTimer = 0;
function log(msg) {
    logEl.textContent = msg;
    logTimer = 3;
}

// ---------- 输入 ----------
const keys = {};
window.addEventListener('keydown', (e) => {
    if (inputFocused) return;
    const k = e.key.toLowerCase();
    const wasDown = keys[k];
    keys[k] = true;

    // 客人：只保留 keys 状态用于上行输入，不本地触发副作用
    const isGuest = state.mp.active && state.mp.role === 'guest';

    if (k === ' ') {
        e.preventDefault();
        if (!isGuest && !dave.isJumping && dave.jumpCooldown <= 0 && !state.gameOver) {
            dave.vy = JUMP_VELOCITY;
            dave.isJumping = true;
            dave.jumpCooldown = JUMP_CD;
            dave.ghost = { x: dave.x, y: dave.y, alpha: 0.6 };
        }
    }
    if (!isGuest) {
        if (k >= '1' && k <= '4') selectCard(parseInt(k) - 1);
        if (k >= '5' && k <= '8') useTempCard(parseInt(k) - 5);
        if (k === 'f') tryPlant();
    }

    // 动作按键（避免与浏览器冲突）
    if (k === 'q' || k === 'e') e.preventDefault();
    if (!wasDown && !isGuest) {
        if (k === 'q')      startDash();
        else if (k === 'e') startGuard();
    }

    if (['arrowup', 'arrowdown', 'arrowleft', 'arrowright'].includes(k)) e.preventDefault();
});
window.addEventListener('keyup', (e) => {
    if (inputFocused) return;
    const k = e.key.toLowerCase();
    keys[k] = false;
    if (k === 'e') endGuard();
});

// ---------- 卡槽选择 ----------
// 鼠标位置追踪（用于挥砍方向 & 铲子瞄准）
const mouse = { x: 0, y: 0, inside: false };
canvas.addEventListener('mousemove', (e) => {
    const rect = canvas.getBoundingClientRect();
    mouse.x = (e.clientX - rect.left) * (W / rect.width);
    mouse.y = (e.clientY - rect.top) * (H / rect.height);
    mouse.inside = true;
});
canvas.addEventListener('mouseleave', () => { mouse.inside = false; });

// 左键点击 → 用当前武器攻击（智能判定）
canvas.addEventListener('mousedown', (e) => {
    if (e.button !== 0) return;
    if (state.gameOver || !gameRunning) return;
    // 客人不本地开火，走 evt 上行（见文件末尾）
    if (state.mp.active && state.mp.role === 'guest') return;
    tryUseWeapon();
});

function tryUseWeapon() {
    const wkey = dave.currentWeapon;
    if (!wkey) {
        log('未装备武器');
        return;
    }
    if (dave.weaponCooldown > 0) return;
    const w = WEAPONS[wkey];
    if (!w) return;

    // 铲子以外的武器：检查耐久
    const isEquipped = wkey === dave.equippedWeapon;
    if (isEquipped) {
        if ((dave.equippedDurability || 0) <= 0) {
            // 用尽：自动切回铲子（若解锁）或空
            log(`${w.name} 已损坏`);
            dave.currentWeapon = isShovelUnlocked() ? 'shovel' : null;
            return;
        }
    }

    // 攻击朝向：优先鼠标方向
    let angle;
    const daveY = dave.y - dave.jumpOffset;
    if (mouse.inside) {
        angle = Math.atan2(mouse.y - daveY, mouse.x - dave.x);
    } else {
        angle = dave.facing > 0 ? 0 : Math.PI;
    }
    dave.facingAngle = angle;

    // 等级倍率（只对玩家装备的武器）
    const mul = isEquipped ? weaponMul(dave.equippedLevel || 1) : 1;

    if (w.kind === 'ranged') {
        // 远程：射子弹
        const speed = w.bulletSpeed || 500;
        const dmg = Math.round(w.damage * mul);
        const pellets = w.pellets || 1;
        const spread = w.spread || 0;
        for (let i = 0; i < pellets; i++) {
            const t = pellets === 1 ? 0 : (i / (pellets - 1) - 0.5);
            const a = angle + t * spread;
            state.bullets.push({
                x: dave.x + Math.cos(a) * 22,
                y: daveY + Math.sin(a) * 22,
                vx: Math.cos(a) * speed,
                vy: Math.sin(a) * speed,
                row: null,           // 自由方向标记（updateBullets 兼容）
                friendly: true,
                damage: dmg,
                color: w.color,
                label: w.bulletLabel || '·',
                life: 1.2,
            });
        }
        dave.weaponCooldown = w.fireInterval / (mul);
        startSwing(angle, wkey);
    } else {
        // 近战：智能判定 (铲子挖植物)
        const cx = dave.x + Math.cos(angle) * (w.reach || 40) * 0.5;
        const cy = daveY + Math.sin(angle) * (w.reach || 40) * 0.5;
        if (w.canDigPlant) {
            const zombieNear = state.zombies.find(z =>
                Math.hypot(z.x - cx, z.y - cy) < (w.reach || 40)
            );
            if (!zombieNear) {
                const plant = findPlantNear(cx, cy, w.reach || 40);
                if (plant) {
                    digPlant(plant);
                    dave.weaponCooldown = w.fireInterval;
                    startSwing(angle, wkey);
                    return;
                }
            }
        }
        // 挥砍扇形
        const dmg = Math.round(w.damage * mul);
        for (const z of state.zombies) {
            const dx = z.x - dave.x;
            const dy = z.y - daveY;
            const dist = Math.hypot(dx, dy);
            if (dist > (w.reach || 40)) continue;
            const zAngle = Math.atan2(dy, dx);
            let delta = zAngle - angle;
            while (delta >  Math.PI) delta -= Math.PI * 2;
            while (delta < -Math.PI) delta += Math.PI * 2;
            if (Math.abs(delta) <= (w.arc || Math.PI) / 2) {
                z.hp -= dmg;
                z.hurtFlash = 0.12;
                state.effects.push({ kind: 'hit', x: z.x, y: z.y, life: 0.15, maxLife: 0.15 });
            }
        }
        dave.weaponCooldown = w.fireInterval / mul;
        startSwing(angle, wkey);
    }

    // 扣耐久（铲子/无限耐久不扣）
    if (isEquipped && w.ammoType !== 'infinite') {
        dave.equippedDurability = Math.max(0, (dave.equippedDurability || 0) - 1);
        if (dave.equippedDurability === 0) {
            log(`${w.name} 耐久耗尽！`);
            // 用尽后回退到铲子或无武器
            dave.currentWeapon = isShovelUnlocked() ? 'shovel' : null;
        }
    }
}

// 触发挥砍动画
function startSwing(angle, wkey) {
    dave.swingTimer = 0.22;
    dave.swingDir = angle;
    dave.swingWeapon = wkey;
}

// ---------- 动作：奔跑 / 滑铲 / 闪避 / 格挡 ----------
function currentMoveDir() {
    // 从按键取当前方向；没有按方向则用 facing
    let vx = 0, vy = 0;
    if (keys['a'] || keys['arrowleft'])  vx -= 1;
    if (keys['d'] || keys['arrowright']) vx += 1;
    if (keys['w'] || keys['arrowup'])    vy -= 1;
    if (keys['s'] || keys['arrowdown'])  vy += 1;
    if (vx === 0 && vy === 0) { vx = dave.facing; vy = 0; }
    const m = Math.hypot(vx, vy) || 1;
    return { x: vx / m, y: vy / m };
}

function startDash() {
    if (state.gameOver || !gameRunning) return;
    if (dave.dashCooldown > 0 || dave.dashing) return;
    dave.dashing = true;
    dave.dashTimer = ACTION.dashDuration;
    dave.dashDir = currentMoveDir();
    dave.dashCooldown = ACTION.dashCooldown;
    dave.invuln = Math.max(dave.invuln, ACTION.dashInvuln);
    dave.dashGhosts = [];
    log('闪避！');
}

function startGuard() {
    if (state.gameOver || !gameRunning) return;
    if (dave.guardCooldown > 0 || dave.guarding) return;
    dave.guarding = true;
    dave.guardTimer = 0;
    // 记录当前朝向作为盾牌方向（跟随鼠标或面朝）
    if (mouse.inside) {
        const daveY = dave.y - dave.jumpOffset;
        dave.guardFacing = Math.atan2(mouse.y - daveY, mouse.x - dave.x);
    } else {
        dave.guardFacing = dave.facing > 0 ? 0 : Math.PI;
    }
}
function endGuard() {
    if (!dave.guarding) return;
    dave.guarding = false;
    dave.guardCooldown = ACTION.guardCooldown;
}
// 判断当前是否在完美格挡窗口内
function inPerfectGuard() {
    return dave.guarding && dave.guardTimer <= ACTION.guardPerfectMs;
}

// 找到附近可铲的植物
function findPlantNear(x, y, r) {
    let best = null, bestDist = Infinity;
    for (const p of state.plants) {
        const d = Math.hypot(p.x - x, p.y - y);
        if (d <= r && d < bestDist) { best = p; bestDist = d; }
    }
    return best;
}

// 铲除植物：返还 50% 阳光
function digPlant(plant) {
    const def = PLANTS[plant.kind];
    const refund = Math.round(def.cost * 0.5);
    state.sun += refund;
    state.effects.push({
        kind: 'pickup', x: plant.x, y: plant.y,
        life: 0.6, maxLife: 0.6, label: `+${refund}`,
    });
    plant.hp = 0;   // 交由 updatePlants 清理
    log(`铲除 ${def.name}，退回 ${refund} 阳光`);
}

function selectCard(idx) {
    if (idx < 0 || idx >= CARD_ORDER.length) return;
    state.selectedCard = state.selectedCard === idx ? -1 : idx;
    cardEls.forEach((el, i) => el.classList.toggle('active', i === state.selectedCard));
}

// ---------- 种植 ----------
// 使用临时植物卡（僵尸掉落的即用卡，按 5/6/7/8）
// 无阳光消耗、无 CD，但用完就消失
function useTempCard(idx) {
    if (state.gameOver) return;
    if (!state.tempCards || !state.tempCards[idx]) {
        log('临时卡槽 ' + (5 + idx) + ' 为空');
        return;
    }
    if (dave.isJumping) { log('空中无法种植'); return; }

    const kind = state.tempCards[idx];
    const def = PLANTS[kind];
    // 间距校验（同行）
    for (const p of state.plants) {
        if (p.row === dave.row && Math.abs(p.x - dave.x) < MIN_PLANT_DIST) {
            log('此处太挤，无法种植'); return;
        }
    }
    if (dave.x < FIELD.left + 20 || dave.x > FIELD.right - 30) {
        log('此处不能种植'); return;
    }

    state.plants.push(makePlant(kind, dave.x, dave.row, dave.y));
    state.tempCards.splice(idx, 1);
    log(`使用即用卡种下 ${def.name}！`);
}

function tryPlant() {
    if (state.gameOver) return;
    if (state.selectedCard < 0) { log('请先选择植物 (按 1-4)'); return; }
    if (dave.isJumping) { log('空中无法种植'); return; }

    const key = CARD_ORDER[state.selectedCard];
    const def = PLANTS[key];

    if (state.cooldowns[key] > 0) { log(`${def.name} 冷却中…`); return; }
    if (state.sun < def.cost) { log(`阳光不足 (需 ${def.cost})`); return; }

    for (const p of state.plants) {
        if (p.row === dave.row && Math.abs(p.x - dave.x) < MIN_PLANT_DIST) {
            log('此处太挤，无法种植'); return;
        }
    }
    if (dave.x < FIELD.left + 20 || dave.x > FIELD.right - 30) {
        log('此处不能种植'); return;
    }

    state.sun -= def.cost;
    state.cooldowns[key] = def.cooldown;
    state.plants.push(makePlant(key, dave.x, dave.row, dave.y));
    log(`种下 ${def.name}`);
}

function makePlant(kind, x, row, y) {
    const def = PLANTS[kind];
    const lv = META.levels[kind] || 1;
    const mul = levelInfo(lv).mul;
    // 血量按等级放大
    const hp = def.hp * mul;
    return {
        kind, x, row,
        y: y != null ? y : rowY(row),
        lv,               // 记录种下时的等级
        mul,              // 等级倍率
        hp,
        maxHp: hp,
        fireTimer: def.fireInterval ? Math.random() * 0.5 : 0,
        produceTimer: def.produceInterval ? 7 + Math.random() * 2 : 0,
        fuseTimer: def.fuse || 0,
        exploded: false,
        shake: 0,
    };
}

// ---------- 阳光 ----------
function spawnNaturalSun() {
    const x = FIELD.left + 40 + Math.random() * (FIELD.right - FIELD.left - 80);
    state.suns.push({
        x, y: FIELD.top - 10,
        targetY: FIELD.top + 40 + Math.random() * (FIELD.bottom - FIELD.top - 80),
        vy: 40, value: 25, life: 10,
    });
}
function spawnSunAt(x, y, value = 25) {
    state.suns.push({
        x, y,
        targetY: y + 30,
        vy: 60, value, life: 10,
    });
}

// ---------- 僵尸生成 ----------
function spawnZombie() {
    let kind;
    // 优先使用关卡定义的僵尸池
    if (state._zombiePool && state._zombiePool.length > 0) {
        kind = state._zombiePool[Math.floor(Math.random() * state._zombiePool.length)];
    } else {
        // 默认逻辑
        kind = 'normal';
        const r = Math.random();
        if (state.wave >= 5 && r < 0.15) kind = 'bucket';
        else if (state.wave >= 4 && r < 0.30) kind = 'spitter';
        else if (state.wave >= 3 && r < 0.50) kind = 'cone';
    }

    const def = ZOMBIES[kind];
    const row = randomActiveRow();
    // 应用难度倍率（不修改原始数据）
    const hp = def.hp * DIFFICULTY.hpMul;
    const speed = def.speed * (0.9 + Math.random() * 0.3) * DIFFICULTY.speedMul;
    state.zombies.push({
        kind,
        x: FIELD.right + 20,
        row,
        y: rowY(row),
        hp,
        maxHp: hp,
        speed,
        eating: null,
        hurtFlash: 0,
    });
    state.zombiesSpawned++;
}

function startWave() {
    state.waveActive = true;
    // 每波数量：基础 3+wave*2，套 countMul
    state.zombiesInWave = Math.max(1, Math.round((3 + state.wave * 2) * DIFFICULTY.countMul));
    state.zombiesSpawned = 0;
    // 生成间隔：基础 max(1.2, 4-wave*0.3)，套 intervalMul
    state.spawnInterval = Math.max(0.4, (4 - state.wave * 0.3) * DIFFICULTY.intervalMul);
    state.spawnTimer = 1;
    log(`第 ${state.wave} 波来袭！共 ${state.zombiesInWave} 只`);
}

// ---------- 主循环 ----------
let lastTime = performance.now();
function loop(now) {
    if (!gameRunning) return;
    const dt = Math.min((now - lastTime) / 1000, 0.05);
    lastTime = now;
    // 弹窗打开时暂停世界
    const settingsEl = document.getElementById('settings-modal');
    const aboutEl = document.getElementById('about-modal');
    const settingsOpen = settingsEl ? !settingsEl.classList.contains('hidden') : false;
    const aboutOpen = aboutEl ? !aboutEl.classList.contains('hidden') : false;
    if (!state.gameOver && !settingsOpen && !aboutOpen) update(dt);
    render();
    updateHUD();
    rafId = requestAnimationFrame(loop);
}

function update(dt) {
    state.time += dt;

    // 客人：完全被动，只发上行输入，不跑本地模拟
    if (state.mp.active && state.mp.role === 'guest') {
        mpGuestSendInput(dt);
        // 客人本地也需要动作 CD / 无敌帧 / 视觉计时递减，让 UI 反馈流畅
        finishDaveTimers(dt);
        return;
    }

    updateDave(dt);
    if (state.mp.active && state.mp.role === 'host') {
        // 应用客人的输入到 dave2，并推进 dave2
        mpHostApplyRemoteInput(dt);
        updateDave2(dt);
    }
    updatePlants(dt);
    updateBullets(dt);
    updateZombies(dt);
    updateSuns(dt);
    updateEffects(dt);
    updatePickups(dt);
    updateCooldowns(dt);
    updateWaves(dt);
    checkDaveDamage(dt);
    if (state.mp.active && state.mp.role === 'host') {
        checkDave2Damage(dt);
        // 广播 snapshot（15Hz）
        state.mp.snapshotAcc += dt;
        if (state.mp.snapshotAcc >= 1 / 15) {
            state.mp.snapshotAcc = 0;
            mpHostBroadcastSnapshot();
        }
    }

    if (logTimer > 0) {
        logTimer -= dt;
        if (logTimer <= 0) {
            logEl.textContent = 'WASD 移动 · Shift 奔跑 · Q 闪避 · E 格挡（完美窗口反弹） · 空格 跳 · 1-4 选卡 · F 种 · 左键 攻击';
        }
    }
}

function updateDave(dt) {
    // 阵亡后旋转倒地
    if (state.gameOver && !state.victory) {
        if (dave.deathRot < Math.PI / 2) dave.deathRot += dt * 3;
        return;
    }
    // 胜利弹跳
    if (state.gameOver && state.victory) {
        dave.victoryBounce += dt;
        return;
    }

    // ---- 动作 CD 递减 ----
    if (dave.dashCooldown  > 0) dave.dashCooldown  -= dt;
    if (dave.guardCooldown > 0) dave.guardCooldown -= dt;
    if (dave.invuln        > 0) dave.invuln        -= dt;
    if (dave.perfectFlash  > 0) dave.perfectFlash  -= dt;

    // ---- 奔跑（Shift 持续）----
    dave.sprinting = !!(keys['shift']);

    // ---- 闪避（短时间高速位移 + 残影）----
    if (dave.dashing) {
        dave.dashTimer -= dt;
        // 记录残影
        dave.dashGhosts.push({ x: dave.x, y: dave.y - dave.jumpOffset, alpha: 0.55 });
        if (dave.dashGhosts.length > 6) dave.dashGhosts.shift();
        dave.x += dave.dashDir.x * ACTION.dashSpeed * dt;
        dave.y += dave.dashDir.y * ACTION.dashSpeed * dt;
        dave.x = Math.max(FIELD.left, Math.min(FIELD.right, dave.x));
        dave.y = Math.max(FIELD.top + 12, Math.min(FIELD.bottom - 12, dave.y));
        if (dave.dashTimer <= 0) dave.dashing = false;
        finishDaveTimers(dt);
        return;
    }

    // 残影淡出
    if (dave.dashGhosts.length) {
        for (const g of dave.dashGhosts) g.alpha -= dt * 3;
        dave.dashGhosts = dave.dashGhosts.filter(g => g.alpha > 0);
    }

    // ---- 格挡计时 ----
    if (dave.guarding) {
        dave.guardTimer += dt;
        // 格挡期间可以低速移动
    }

    let vx = 0, vy = 0;
    if (keys['a'] || keys['arrowleft']) vx -= 1;
    if (keys['d'] || keys['arrowright']) vx += 1;
    if (keys['w'] || keys['arrowup']) vy -= 1;
    if (keys['s'] || keys['arrowdown']) vy += 1;

    // 归一化对角速度（避免 √2 加速）
    if (vx !== 0 && vy !== 0) {
        const inv = 1 / Math.SQRT2;
        vx *= inv; vy *= inv;
    }

    // 速度倍率：奔跑 1.65×，格挡 0.55×
    let mul = 1;
    if (dave.sprinting) mul *= dave.sprintMul;
    if (dave.guarding)  mul *= 0.55;

    if (vx !== 0) {
        dave.x += vx * dave.speed * mul * dt;
        dave.facing = vx > 0 ? 1 : -1;
        dave.facingAngle = Math.atan2(vy, vx);
        dave.x = Math.max(FIELD.left, Math.min(FIELD.right, dave.x));
    } else if (vy !== 0) {
        dave.facingAngle = vy > 0 ? Math.PI / 2 : -Math.PI / 2;
    }

    if (vy !== 0) {
        dave.y += vy * dave.speedY * mul * dt;
        dave.y = Math.max(FIELD.top + 12, Math.min(FIELD.bottom - 12, dave.y));
    }

    finishDaveTimers(dt);
}

function finishDaveTimers(dt) {
    if (dave.isJumping) {
        dave.jumpOffset += dave.vy * dt;
        dave.vy -= GRAVITY * dt;
        if (dave.jumpOffset <= 0) {
            dave.jumpOffset = 0;
            dave.vy = 0;
            dave.isJumping = false;
        }
    }
    if (dave.jumpCooldown > 0) dave.jumpCooldown -= dt;
    if (dave.ghost) {
        dave.ghost.alpha -= dt * 2;
        if (dave.ghost.alpha <= 0) dave.ghost = null;
    }
    if (dave.hurtFlash > 0) dave.hurtFlash -= dt;
    if (dave.weaponCooldown > 0) dave.weaponCooldown -= dt;
    if (dave.swingTimer > 0) dave.swingTimer -= dt;
    // 后仰逐渐归零
    if (Math.abs(dave.recoil) > 0.1) {
        dave.recoil *= Math.max(0, 1 - dt * 8);
    } else {
        dave.recoil = 0;
    }
}

function updatePlants(dt) {
    for (let i = state.plants.length - 1; i >= 0; i--) {
        const p = state.plants[i];
        const def = PLANTS[p.kind];
        const mul = p.mul || 1;   // 兼容：旧种下的植物没有 mul
        if (p.shake > 0) p.shake -= dt;

        if (def.produceInterval) {
            p.produceTimer -= dt;
            if (p.produceTimer <= 0) {
                // 等级提升 → 周期缩短（除以倍率）
                p.produceTimer = def.produceInterval / mul;
                spawnSunAt(p.x, p.y, 25);
            }
        }
        if (def.fireInterval) {
            p.fireTimer -= dt;
            const hasTarget = state.zombies.some(z => z.row === p.row && z.x > p.x && z.x < p.x + def.range);
            if (p.fireTimer <= 0 && hasTarget) {
                p.fireTimer = def.fireInterval / (DIFFICULTY.attackSpeedMul || 1);
                state.bullets.push({
                    x: p.x + 20, y: p.y, row: p.row,
                    vx: 380, damage: def.bulletDamage * mul,   // 伤害 × 等级倍率
                    color: def.color, label: '豌',
                });
            }
        }
        if (def.fuse) {
            p.fuseTimer -= dt;
            if (p.fuseTimer <= 0 && !p.exploded) {
                p.exploded = true;
                const radius = def.blastRadius * mul;  // 半径 × 等级倍率
                for (const z of state.zombies) {
                    if (Math.hypot(z.x - p.x, z.y - p.y) < radius) {
                        z.hp -= def.blastDamage;
                        z.hurtFlash = 0.15;
                    }
                }
                state.effects.push({
                    kind: 'boom', x: p.x, y: p.y,
                    radius, life: 0.5, maxLife: 0.5,
                });
                p.hp = 0;
                log('轰！');
            }
        }
        if (p.hp <= 0) state.plants.splice(i, 1);
    }
}

function updateBullets(dt) {
    for (let i = state.bullets.length - 1; i >= 0; i--) {
        const b = state.bullets[i];
        b.x += b.vx * dt;
        if (b.vy) b.y += b.vy * dt;
        // 出界 / 生命结束
        if (b.x > FIELD.right + 20 || b.x < FIELD.left - 20
            || b.y < FIELD.top - 20 || b.y > FIELD.bottom + 20) {
            state.bullets.splice(i, 1); continue;
        }
        if (b.life != null) {
            b.life -= dt;
            if (b.life <= 0) { state.bullets.splice(i, 1); continue; }
        }

        // 敌人子弹命中戴夫的判定
        if (b.enemy) {
            const daveY = dave.y - dave.jumpOffset;
            if (Math.hypot(b.x - dave.x, b.y - daveY) < 20) {
                // 无敌帧：直接免伤
                if (dave.invuln > 0) {
                    state.bullets.splice(i, 1);
                    continue;
                }
                // 格挡：完美窗口 → 反弹；普通格挡 → 免伤
                if (dave.guarding) {
                    if (inPerfectGuard()) {
                        // 反弹：转向 + 变友军 + 加伤
                        b.vx = -b.vx;
                        b.vy = -b.vy;
                        b.enemy = false;
                        b.friendly = true;
                        b.damage = Math.round((b.damage || 1) * ACTION.perfectReflectMul * 20); // 敌人子弹伤害是"命中扣 1 HP"，反弹按 20 基准折算成对僵尸伤害
                        b.color = '#FFEE66';
                        b.label = '✦';
                        dave.perfectFlash = 0.4;
                        log('★ 完美格挡·反弹！');
                    } else {
                        // 普通格挡：免伤但子弹消失
                        state.bullets.splice(i, 1);
                    }
                    continue;
                }
                // 中弹
                dave.hurtFlash = 0.15;
                dave.hp--;
                dave.recoil = (b.vx < 0 ? 1 : -1) * 6;
                dave.invuln = Math.max(dave.invuln, 0.6);
                log('被远程僵尸击中！HP -1');
                if (dave.hp <= 0) gameOver(false);
                state.bullets.splice(i, 1);
                continue;
            }
        }

        // 命中判定（对僵尸）
        let hit = null;
        if (b.friendly) {
            // 自由方向：圆形近距命中
            let bestDist = 22;
            for (const z of state.zombies) {
                if (z.hp <= 0) continue;
                const d = Math.hypot(z.x - b.x, z.y - b.y);
                if (d < bestDist) { bestDist = d; hit = z; }
            }
        } else if (!b.enemy) {
            // 传统 row-based：植物子弹
            for (const z of state.zombies) {
                if (z.row === b.row && z.hp > 0 && Math.abs(z.x - b.x) < 20) {
                    if (!hit || z.x < hit.x) hit = z;
                }
            }
        }
        if (hit) {
            hit.hp -= b.damage;
            hit.hurtFlash = 0.12;
            state.effects.push({ kind: 'hit', x: b.x, y: b.y, life: 0.15, maxLife: 0.15 });
            state.bullets.splice(i, 1);
        }
    }
}

function updateZombies(dt) {
    for (let i = state.zombies.length - 1; i >= 0; i--) {
        const z = state.zombies[i];
        const def = ZOMBIES[z.kind];

        // 硬直：完美格挡触发的僵尸僵直
        if (z._stunTimer && z._stunTimer > 0) {
            z._stunTimer -= dt;
            if (z._stunTimer <= 0) { z._stunned = false; }
            if (z.hurtFlash > 0) z.hurtFlash -= dt;
            if (z.hp <= 0) {
                state.effects.push({ kind: 'dead', x: z.x, y: z.y, life: 0.6, maxLife: 0.6, label: def.name });
                spawnZombieDrops(z);
                state.zombies.splice(i, 1);
                state.killedTotal++;
            }
            continue;
        }

        let blocker = null;
        for (const p of state.plants) {
            if (p.row === z.row && p.x < z.x && p.x > z.x - 30) {
                if (!blocker || p.x > blocker.x) blocker = p;
            }
        }
        // 远程僵尸：在射程内停下开火
        if (def.ranged) {
            const dist = z.x - dave.x;
            const daveY = dave.y - dave.jumpOffset;
            const rowDy = Math.abs(dave.y - z.y);
            const inRange = dist > 60 && dist < (def.range || 380) && rowDy < 40;
            if (blocker) {
                z.eating = blocker;
                blocker.hp -= def.damage * dt;
                blocker.shake = 0.1;
            } else if (inRange) {
                z.eating = null;
                z._shootTimer = (z._shootTimer || 0) - dt;
                if (z._shootTimer <= 0) {
                    z._shootTimer = def.fireInterval || 2.0;
                    // 朝戴夫射子弹
                    const dx = dave.x - z.x;
                    const dy = daveY - z.y;
                    const d = Math.hypot(dx, dy) || 1;
                    state.bullets.push({
                        x: z.x - 12, y: z.y,
                        vx: (dx / d) * (def.bulletSpeed || 320),
                        vy: (dy / d) * (def.bulletSpeed || 320),
                        row: null,
                        friendly: false,
                        enemy: true,
                        damage: def.bulletDamage || 1,
                        color: def.bulletColor || '#FF6666',
                        label: def.bulletLabel || '×',
                        life: 2.5,
                    });
                }
            } else {
                z.eating = null;
                z.x -= z.speed * dt;
            }
        } else if (blocker) {
            z.eating = blocker;
            blocker.hp -= def.damage * dt;
            blocker.shake = 0.1;
        } else {
            z.eating = null;
            z.x -= z.speed * dt;
        }
        if (z.hurtFlash > 0) z.hurtFlash -= dt;

        if (z.x < FIELD.left - 10) gameOver(false);

        if (z.hp <= 0) {
            state.effects.push({
                kind: 'dead', x: z.x, y: z.y,
                life: 0.6, maxLife: 0.6, label: def.name,
            });
            // 掉落物
            spawnZombieDrops(z);
            state.zombies.splice(i, 1);
            state.killedTotal++;
        }
    }

    if (state.waveActive &&
        state.zombiesSpawned >= state.zombiesInWave &&
        state.zombies.length === 0) {
        state.waveActive = false;
        if (state.wave >= state.maxWave) {
            gameOver(true);
        } else {
            state.wave++;
            state.waveTimer = 12 * DIFFICULTY.restMul;
            log(`第 ${state.wave - 1} 波清空！休整 12 秒…`);
        }
    }
}

function updateSuns(dt) {
    const daveY = dave.y - dave.jumpOffset;
    const PICK_RADIUS = 28;   // 接触拾取半径
    for (let i = state.suns.length - 1; i >= 0; i--) {
        const s = state.suns[i];
        if (s.y < s.targetY) {
            s.y += s.vy * dt;
            if (s.y > s.targetY) s.y = s.targetY;
        }
        // 接触即拾（戴夫任意位置只要碰到就吃）
        if (Math.hypot(s.x - dave.x, s.y - daveY) < PICK_RADIUS) {
            state.sun += s.value;
            state.effects.push({
                kind: 'pickup', x: s.x, y: s.y,
                life: 0.6, maxLife: 0.6, label: `+${s.value}`,
            });
            state.suns.splice(i, 1);
            continue;
        }
        s.life -= dt;
        if (s.life <= 0) state.suns.splice(i, 1);
    }
    state.naturalSunTimer -= dt;
    if (state.naturalSunTimer <= 0) {
        // 原版 PvZ：天降阳光间隔 5~10s，随波次略微加快
        const base = Math.max(4, 10 - state.wave * 0.3);
        state.naturalSunTimer = base + Math.random() * 5;
        spawnNaturalSun();
    }
}

function updateEffects(dt) {
    for (let i = state.effects.length - 1; i >= 0; i--) {
        const e = state.effects[i];
        e.life -= dt;
        if (e.life <= 0) state.effects.splice(i, 1);
    }
}

// ---------- 掉落物：银币/金币/钻石/血包/植物碎片 ----------
// 类型定义（字符 + 颜色）
const PICKUP_DEFS = {
    silver:   { label: '银', color: '#C0C0C0', shadow: '#909090' },
    gold:     { label: '金', color: '#FFD700', shadow: '#FFA500' },
    gem:      { label: '钻', color: '#66FFFF', shadow: '#00CCFF' },
    heal:     { label: '药', color: '#FF6688', shadow: '#FF3366' },
    fragment: { label: '片', color: '#AA88FF', shadow: '#7755CC' },
    card:     { label: '卡', color: '#00FFAA', shadow: '#00FF88' },
    wfrag:    { label: '械', color: '#FFCC66', shadow: '#CC9933' },
};

// 僵尸死亡：按掉落表生成拾取物
function spawnZombieDrops(z) {
    const table = DROP_TABLE[z.kind];
    if (!table) return;
    const rate = DIFFICULTY.dropRateMul || 1;
    const rew = DIFFICULTY.rewardMul || 1;

    // 银币
    if (Math.random() < table.silver.chance * rate) {
        const n = Math.max(1, Math.round(randInt(table.silver.min, table.silver.max) * rew));
        spawnPickup(z.x, z.y, 'silver', n);
    }
    // 金币
    if (Math.random() < table.gold.chance * rate) {
        const n = Math.max(1, Math.round(randInt(table.gold.min, table.gold.max) * rew));
        spawnPickup(z.x, z.y, 'gold', n);
    }
    // 钻石
    if (table.gem.chance > 0 && Math.random() < table.gem.chance * rate) {
        const n = Math.max(1, randInt(table.gem.min, table.gem.max));
        spawnPickup(z.x, z.y, 'gem', n);
    }
    // 血包
    if (Math.random() < table.heal.chance * rate) {
        spawnPickup(z.x, z.y, 'heal', 1);
    }
    // 植物碎片（局外持久）
    if (Math.random() < table.fragment.chance * rate) {
        const n = Math.max(1, Math.round(randInt(table.fragment.min, table.fragment.max) * rew));
        const plant = pickWeightedFragment(z.kind);
        spawnPickup(z.x, z.y, 'fragment', n, plant);
    }
    // 局内即用植物卡（拾到本局可无成本使用一次）
    if (table.card && Math.random() < table.card.chance * rate) {
        const plant = pickWeightedFragment(z.kind);
        spawnPickup(z.x, z.y, 'card', 1, plant);
    }
    // 武器碎片（局外持久）
    if (table.wfrag && Math.random() < table.wfrag.chance * rate) {
        const n = Math.max(1, Math.round(randInt(table.wfrag.min, table.wfrag.max) * rew));
        const wkey = pickWeightedWeaponFrag(z.kind);
        spawnPickup(z.x, z.y, 'wfrag', n, wkey);
    }
}
function randInt(a, b) {
    return Math.floor(a + Math.random() * (b - a + 1));
}

function spawnPickup(x, y, kind, amount, extra) {
    // 略微散开，避免重叠
    const dx = (Math.random() - 0.5) * 20;
    const dy = (Math.random() - 0.5) * 20;
    state.pickups.push({
        kind, x: x + dx, y: y + dy,
        amount: amount || 1,
        extra: extra || null,     // 碎片时存放植物 kind
        vy: -80,                   // 初始向上弹
        life: 12,
        hopPhase: 0,
    });
}

function updatePickups(dt) {
    const daveY = dave.y - dave.jumpOffset;
    const PICK_R = 30;
    for (let i = state.pickups.length - 1; i >= 0; i--) {
        const p = state.pickups[i];
        // 抛物线弹一下，然后停在原地小幅浮动
        p.y += p.vy * dt;
        p.vy += 240 * dt;   // 重力
        // 落到略高于起始点，防止穿出屏幕
        if (p.vy > 0 && p.y > FIELD.bottom - 20) {
            p.y = FIELD.bottom - 20;
            p.vy = 0;
        }
        p.hopPhase += dt * 3;
        p.life -= dt;
        if (p.life <= 0) { state.pickups.splice(i, 1); continue; }
        // 接触拾取
        if (Math.hypot(p.x - dave.x, p.y - daveY) < PICK_R) {
            collectPickup(p);
            state.pickups.splice(i, 1);
        }
    }
}

function collectPickup(p) {
    if (p.kind === 'silver' || p.kind === 'gold' || p.kind === 'gem') {
        addCurrency(p.kind, p.amount);
        if (state.roundRewards) state.roundRewards[p.kind] += p.amount;
    } else if (p.kind === 'heal') {
        // 满血则跳过，否则回 1
        if (dave.hp < 3) {
            dave.hp = Math.min(3, dave.hp + 1);
        }
    } else if (p.kind === 'fragment') {
        const plant = p.extra || 'peashooter';
        META.fragments[plant] = (META.fragments[plant] || 0) + p.amount;
        saveFragments(META.fragments);
        if (state.roundRewards) {
            state.roundRewards.fragments[plant] = (state.roundRewards.fragments[plant] || 0) + p.amount;
        }
    } else if (p.kind === 'card') {
        // 局内即用卡：加入临时卡槽
        const plant = p.extra || 'peashooter';
        if (!state.tempCards) state.tempCards = [];
        state.tempCards.push(plant);
        const pdef = PLANTS[plant];
        log(`拾到 ${pdef?.name || plant} 即用卡！按 ${5 + state.tempCards.length - 1} 使用`);
    } else if (p.kind === 'wfrag') {
        // 武器碎片：局外持久
        const wkey = p.extra || 'pistol';
        META.weaponFrags[wkey] = (META.weaponFrags[wkey] || 0) + p.amount;
        saveWeaponFrags();
        if (state.roundRewards) {
            if (!state.roundRewards.wfrags) state.roundRewards.wfrags = {};
            state.roundRewards.wfrags[wkey] = (state.roundRewards.wfrags[wkey] || 0) + p.amount;
        }
        const wm = WEAPON_META[wkey];
        log(`拾到 ${wm?.fragLabel || '武器碎片'} × ${p.amount}`);
    }
    // 拾取动画：金字上飘
    const def = PICKUP_DEFS[p.kind];
    state.effects.push({
        kind: 'pickup', x: p.x, y: p.y,
        life: 0.7, maxLife: 0.7,
        label: p.kind === 'heal' ? '+HP' : `+${p.amount} ${def.label}`,
    });
}

function updateCooldowns(dt) {
    for (const k of CARD_ORDER) {
        if (state.cooldowns[k] > 0) state.cooldowns[k] -= dt;
    }
}

function updateWaves(dt) {
    if (!state.waveActive) {
        state.waveTimer -= dt;
        if (state.waveTimer <= 0) startWave();
        return;
    }
    if (state.zombiesSpawned < state.zombiesInWave) {
        state.spawnTimer -= dt;
        if (state.spawnTimer <= 0) {
            state.spawnTimer = state.spawnInterval;
            spawnZombie();
        }
    }
}

function checkDaveDamage(dt) {
    if (dave.isJumping) { dave._damageAcc = 0; return; }
    // 无敌帧：滑铲/闪避/受击保护
    if (dave.invuln > 0) { dave._damageAcc = 0; return; }
    for (const z of state.zombies) {
        if (z.row === dave.row && Math.abs(z.x - dave.x) < 25) {
            // 格挡中：完全免伤；完美窗口内额外硬直僵尸
            if (dave.guarding) {
                dave._damageAcc = 0;
                if (inPerfectGuard() && !z._stunned) {
                    z._stunTimer = ACTION.perfectStunTime;
                    z._stunned = true;
                    z.hurtFlash = 0.2;
                    dave.perfectFlash = 0.35;
                    log('★ 完美格挡！');
                    // 反击：把僵尸推回一点
                    z.x += 30;
                }
                return;
            }
            dave.hurtFlash = 0.15;
            dave._damageAcc += dt;
            if (dave._damageAcc >= 1) {
                dave._damageAcc = 0;
                dave.hp--;
                dave.recoil = (dave.x < z.x ? -1 : 1) * 6;
                dave.invuln = Math.max(dave.invuln, 0.6); // 受击后 0.6s 无敌
                log(`被 ${ZOMBIES[z.kind].name} 咬了！HP -1`);
                if (dave.hp <= 0) gameOver(false);
            }
            return;
        }
    }
    dave._damageAcc = 0;
}

function gameOver(win) {
    if (state.gameOver) return;   // 防重复触发
    state.gameOver = true;
    state.victory = win;
    log(win ? '胜利！全部僵尸已清除！' : '失败！僵尸攻破了防线…');
    // 通关记录写档
    if (win && typeof currentLevel !== 'undefined' && currentLevel) {
        if (!saveData.cleared.includes(currentLevel.id)) {
            saveData.cleared.push(currentLevel.id);
        }
        writeSave(saveData);
        refreshContinueBtn();
    }
    // 延迟弹出结算 UI，让戴夫先播完动作（胜利弹跳/阵亡旋转）
    setTimeout(() => showResultModal(win), 1400);
}

// 显示结算弹窗
function showResultModal(win) {
    const modal = document.getElementById('result-modal');
    if (!modal) return;

    const title = document.getElementById('result-title');
    const icon = document.getElementById('result-icon');
    const stat = document.getElementById('result-stat');
    const rewards = document.getElementById('result-rewards');
    const tip = document.getElementById('result-tip');
    const btnNext = document.getElementById('btn-result-next');

    title.textContent = win ? '胜  利' : '失  败';
    title.className = 'modal-title ' + (win ? 'win' : 'lose');
    icon.textContent = win ? '胜' : '败';
    icon.className = 'result-icon ' + (win ? 'win' : 'lose');
    stat.innerHTML = `击杀 <b>${state.killedTotal || 0}</b> · 波次 <b>${state.wave}</b> / <b>${state.maxWave}</b>`;
    if (rewards) {
        rewards.innerHTML = '';
        const r = state.roundRewards || { silver: 0, gold: 0, gem: 0, fragments: {} };
        const parts = [];
        if (r.silver > 0) parts.push(`<span class="rw-silver">银 +${r.silver}</span>`);
        if (r.gold > 0)   parts.push(`<span class="rw-gold">金 +${r.gold}</span>`);
        if (r.gem > 0)    parts.push(`<span class="rw-gem">钻 +${r.gem}</span>`);
        const fragParts = [];
        Object.entries(r.fragments || {}).forEach(([kind, n]) => {
            if (n > 0) {
                const pdef = PLANTS[kind];
                fragParts.push(`<span class="rw-frag" style="color:${pdef?.color || '#AA88FF'}">${pdef?.name?.charAt(0) || '?'}片 +${n}</span>`);
            }
        });
        Object.entries(r.wfrags || {}).forEach(([kind, n]) => {
            if (n > 0) {
                const wm = WEAPON_META[kind];
                fragParts.push(`<span class="rw-wfrag">${wm?.fragLabel || '械'} +${n}</span>`);
            }
        });
        if (parts.length || fragParts.length) {
            rewards.innerHTML = '<div class="rw-title">本局奖励</div><div class="rw-list">' + parts.concat(fragParts).join(' ') + '</div>';
        }
    }

    // 是否有下一关
    let nextLevel = null;
    if (win && currentLevel) {
        const idx = LEVELS.findIndex(l => l.id === currentLevel.id);
        if (idx >= 0 && idx < LEVELS.length - 1) nextLevel = LEVELS[idx + 1];
    }
    if (nextLevel) {
        btnNext.classList.remove('hidden');
        btnNext.textContent = `下一关 ${nextLevel.id} ▶`;
        btnNext.onclick = () => {
            hideResultModal();
            startGame(nextLevel);
        };
    } else {
        btnNext.classList.add('hidden');
    }

    if (tip) {
        if (win && currentLevel && currentLevel.id === '1-3' && !saveData.__shovelToldOnce) {
            tip.innerHTML = '<span class="c-green">★ 通关 1-3 · 已解锁铲子！</span><br>下一局起自动装备，左键攻击僵尸或铲除植物退回 50% 阳光';
            saveData.__shovelToldOnce = true;
            writeSave(saveData);
        } else if (win) {
            tip.textContent = nextLevel ? '继续挑战下一关，或返回主页整理装备。' : '恭喜通关全部关卡！';
        } else {
            tip.textContent = '再接再厉。可点『重新游戏』再战一局。';
        }
    }

    modal.classList.remove('hidden');
}
function hideResultModal() {
    const modal = document.getElementById('result-modal');
    if (modal) modal.classList.add('hidden');
}

// ---------- 渲染 ----------
function render() {
    ctx.fillStyle = '#000';
    ctx.fillRect(0, 0, W, H);
    drawRowHighlight();
    drawField();
    drawPlantPreview();
    drawPlants();
    drawZombies();
    drawBullets();
    drawSuns();
    drawEffects();
    drawPickups();
    if (state.mp.active) drawDave2();
    drawDave();
    drawOverlays();
}

// 简易渲染远端玩家（仅字形 + 状态标签）
function drawDave2() {
    const d = dave2;
    const y = d.y - (d.jumpOffset || 0);
    ctx.save();
    // 残影：闪避
    if (d._dashing) {
        ctx.globalAlpha = 0.4;
        ctx.fillStyle = '#66FFCC';
        ctx.font = 'bold 20px "Microsoft YaHei", monospace';
        ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
        ctx.fillText(d.label, d.x - 16, y);
        ctx.globalAlpha = 1;
    }
    ctx.fillStyle = d.hurtFlash > 0 ? '#FF4444' : d.color;
    ctx.font = 'bold 20px "Microsoft YaHei", monospace';
    ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
    ctx.shadowColor = d.color;
    ctx.shadowBlur = d.isJumping ? 12 : 4;
    ctx.fillText(d.label, d.x, y);
    // 盾牌
    if (d.guarding) {
        ctx.strokeStyle = d._perfect ? '#FFEE66' : '#88CCFF';
        ctx.lineWidth = 3;
        ctx.shadowColor = '#88CCFF';
        ctx.shadowBlur = 10;
        ctx.beginPath();
        ctx.arc(d.x + Math.cos(d.guardFacing || 0) * 24, y + Math.sin(d.guardFacing || 0) * 24,
                12, (d.guardFacing || 0) - Math.PI * 0.55, (d.guardFacing || 0) + Math.PI * 0.55);
        ctx.stroke();
    }
    ctx.restore();
}

function drawRowHighlight() {
    ctx.fillStyle = 'rgba(0, 255, 100, 0.04)';
    ctx.fillRect(FIELD.left, FIELD.top + FIELD.rowHeight * dave.row, FIELD.right - FIELD.left, FIELD.rowHeight);
}

function drawField() {
    // 先给禁用行盖一层暗色遮罩（视觉上"关闭"）
    ctx.save();
    ctx.fillStyle = 'rgba(20, 20, 20, 0.85)';
    for (let i = 0; i < FIELD.rows; i++) {
        if (!isRowActive(i)) {
            ctx.fillRect(FIELD.left, FIELD.top + FIELD.rowHeight * i, FIELD.right - FIELD.left, FIELD.rowHeight);
        }
    }
    ctx.restore();

    // 分隔线
    ctx.strokeStyle = '#0a2a10';
    ctx.lineWidth = 1;
    ctx.setLineDash([4, 6]);
    for (let i = 1; i < FIELD.rows; i++) {
        const y = FIELD.top + FIELD.rowHeight * i;
        ctx.beginPath();
        ctx.moveTo(FIELD.left, y);
        ctx.lineTo(FIELD.right, y);
        ctx.stroke();
    }
    ctx.setLineDash([]);
    ctx.strokeStyle = '#331111';
    ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.moveTo(FIELD.left, FIELD.top);
    ctx.lineTo(FIELD.left, FIELD.bottom);
    ctx.stroke();
    ctx.strokeStyle = '#330000';
    ctx.setLineDash([2, 8]);
    ctx.beginPath();
    ctx.moveTo(FIELD.right, FIELD.top);
    ctx.lineTo(FIELD.right, FIELD.bottom);
    ctx.stroke();
    ctx.setLineDash([]);
    ctx.fillStyle = '#222';
    ctx.font = '10px Consolas, monospace';
    ctx.textAlign = 'left';
    ctx.textBaseline = 'middle';
    for (let i = 0; i < FIELD.rows; i++) {
        ctx.fillText(`行${i + 1}`, 6, rowY(i));
    }
}

function drawPlantPreview() {
    if (state.selectedCard < 0 || dave.isJumping) return;
    const key = CARD_ORDER[state.selectedCard];
    const def = PLANTS[key];

    let ok = state.sun >= def.cost && state.cooldowns[key] <= 0;
    let reason = '';
    if (state.sun < def.cost) { ok = false; reason = '阳光不足'; }
    else if (state.cooldowns[key] > 0) { ok = false; reason = '冷却中'; }
    for (const p of state.plants) {
        if (p.row === dave.row && Math.abs(p.x - dave.x) < MIN_PLANT_DIST) {
            ok = false; reason = '太挤';
        }
    }
    if (dave.x < FIELD.left + 20 || dave.x > FIELD.right - 30) { ok = false; reason = '禁种区'; }

    ctx.save();
    ctx.globalAlpha = 0.4;
    ctx.fillStyle = ok ? def.color : '#FF4444';
    ctx.font = 'bold 18px "Microsoft YaHei", monospace';
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    ctx.fillText(def.name, dave.x, rowY(dave.row));
    if (!ok) {
        ctx.globalAlpha = 0.85;
        ctx.font = '10px "Microsoft YaHei", monospace';
        ctx.fillStyle = '#FF6666';
        ctx.fillText(reason, dave.x, rowY(dave.row) + 18);
    }
    ctx.restore();
}

function drawPlants() {
    for (const p of state.plants) {
        const def = PLANTS[p.kind];
        ctx.save();
        const shakeX = p.shake > 0 ? (Math.random() - 0.5) * 3 : 0;
        ctx.fillStyle = def.color;
        ctx.font = 'bold 18px "Microsoft YaHei", monospace';
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.fillText(def.name, p.x + shakeX, p.y);

        // 等级角标（Lv 2 起显示）
        if (p.lv && p.lv >= 2) {
            const isAwaken = p.lv >= 5;
            ctx.fillStyle = isAwaken ? '#FF88DD' : '#FFD700';
            ctx.font = 'bold 9px Consolas, monospace';
            ctx.textAlign = 'left';
            ctx.textBaseline = 'top';
            ctx.shadowColor = ctx.fillStyle;
            ctx.shadowBlur = 6;
            ctx.fillText(isAwaken ? '★' : `L${p.lv}`, p.x + 18, p.y - 12);
            ctx.shadowBlur = 0;
            ctx.textAlign = 'center';
            ctx.textBaseline = 'middle';
        }

        if (p.hp < p.maxHp && p.kind !== 'cherry') {
            const w = 30;
            const ratio = Math.max(0, p.hp / p.maxHp);
            ctx.fillStyle = '#222';
            ctx.fillRect(p.x - w / 2, p.y + 14, w, 3);
            ctx.fillStyle = ratio > 0.4 ? '#00FF00' : '#FF4444';
            ctx.fillRect(p.x - w / 2, p.y + 14, w * ratio, 3);
        }
        if (p.kind === 'cherry') {
            ctx.fillStyle = '#FF9999';
            ctx.font = '10px "Microsoft YaHei", monospace';
            ctx.fillText(p.fuseTimer.toFixed(1), p.x, p.y - 14);
        }
        ctx.restore();
    }
}

function drawZombies() {
    for (const z of state.zombies) {
        const def = ZOMBIES[z.kind];
        ctx.save();
        ctx.fillStyle = z.hurtFlash > 0 ? '#FFFFFF' : def.color;
        ctx.font = 'bold 18px "Microsoft YaHei", monospace';
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        if (z.hp / z.maxHp < 0.3) ctx.globalAlpha = 0.7;
        ctx.fillText(def.name, z.x, z.y);

        const w = 34;
        const ratio = Math.max(0, z.hp / z.maxHp);
        ctx.globalAlpha = 1;
        ctx.fillStyle = '#222';
        ctx.fillRect(z.x - w / 2, z.y + 14, w, 3);
        ctx.fillStyle = '#FF4444';
        ctx.fillRect(z.x - w / 2, z.y + 14, w * ratio, 3);
        ctx.restore();
    }
}

function drawBullets() {
    for (const b of state.bullets) {
        ctx.fillStyle = b.color;
        ctx.font = 'bold 14px "Microsoft YaHei", monospace';
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.fillText(b.label, b.x, b.y);
    }
}

function drawSuns() {
    for (const s of state.suns) {
        const flash = s.life < 3 && Math.floor(s.life * 6) % 2 === 0;
        ctx.save();
        ctx.fillStyle = flash ? '#FFF' : '#FFD700';
        ctx.shadowColor = '#FFD700';
        ctx.shadowBlur = 10;
        ctx.font = 'bold 20px "Microsoft YaHei", monospace';
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.fillText('阳', s.x, s.y);
        ctx.restore();
    }
}

function drawEffects() {
    for (const e of state.effects) {
        const t = e.life / e.maxLife;
        ctx.save();
        if (e.kind === 'boom') {
            ctx.globalAlpha = t;
            ctx.strokeStyle = '#FF4400';
            ctx.lineWidth = 3;
            ctx.beginPath();
            ctx.arc(e.x, e.y, e.radius * (1 - t) * 1.1, 0, Math.PI * 2);
            ctx.stroke();
            ctx.fillStyle = '#FF6633';
            ctx.font = 'bold 22px "Microsoft YaHei", monospace';
            ctx.textAlign = 'center';
            ctx.textBaseline = 'middle';
            ctx.fillText('轰！', e.x, e.y);
        } else if (e.kind === 'hit') {
            ctx.globalAlpha = t;
            ctx.fillStyle = '#FFFFFF';
            ctx.font = 'bold 14px "Microsoft YaHei", monospace';
            ctx.textAlign = 'center';
            ctx.textBaseline = 'middle';
            ctx.fillText('×', e.x, e.y);
        } else if (e.kind === 'dead') {
            ctx.globalAlpha = t;
            ctx.fillStyle = '#666';
            ctx.font = '16px "Microsoft YaHei", monospace';
            ctx.textAlign = 'center';
            ctx.textBaseline = 'middle';
            ctx.fillText(e.label || '碎', e.x, e.y - (1 - t) * 20);
        } else if (e.kind === 'pickup') {
            ctx.globalAlpha = t;
            ctx.fillStyle = '#FFD700';
            ctx.shadowColor = '#FFD700';
            ctx.shadowBlur = 8;
            ctx.font = 'bold 14px "Microsoft YaHei", monospace';
            ctx.textAlign = 'center';
            ctx.textBaseline = 'middle';
            ctx.fillText(e.label, e.x, e.y - (1 - t) * 30);
        }
        ctx.restore();
    }
}

// 掉落物渲染：字 + 光晕 + 数量下标 + 剩余时间闪烁
function drawPickups() {
    for (const p of state.pickups) {
        const def = PICKUP_DEFS[p.kind];
        if (!def) continue;
        const hop = Math.sin(p.hopPhase) * 3;
        const flashing = p.life < 3 && Math.floor(p.life * 6) % 2 === 0;
        ctx.save();
        ctx.fillStyle = flashing ? '#FFFFFF' : def.color;
        ctx.shadowColor = def.shadow;
        ctx.shadowBlur = 10;
        ctx.font = 'bold 16px "Microsoft YaHei", monospace';
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.fillText(def.label, p.x, p.y + hop);
        // 数量（>1 显示）
        if (p.amount > 1) {
            ctx.shadowBlur = 0;
            ctx.font = 'bold 10px Consolas, monospace';
            ctx.fillStyle = '#FFF';
            ctx.fillText(`×${p.amount}`, p.x + 12, p.y + hop + 8);
        }
        // 碎片：小字标注属于哪种植物
        if (p.kind === 'fragment' && p.extra) {
            const plantDef = PLANTS[p.extra];
            if (plantDef) {
                ctx.shadowBlur = 0;
                ctx.font = '9px "Microsoft YaHei", monospace';
                ctx.fillStyle = plantDef.color;
                ctx.fillText(plantDef.name.charAt(0), p.x, p.y + hop - 12);
            }
        }
        // 武器碎片：小字标注属于哪种武器
        if (p.kind === 'wfrag' && p.extra) {
            const wdef = WEAPONS[p.extra];
            const wm = WEAPON_META[p.extra];
            if (wdef && wm) {
                ctx.shadowBlur = 0;
                ctx.font = '9px "Microsoft YaHei", monospace';
                ctx.fillStyle = wdef.color;
                ctx.fillText(wm.fragLabel, p.x, p.y + hop - 12);
            }
        }
        ctx.restore();
    }
}

function drawDave() {
    // 闪避残影
    if (dave.dashGhosts && dave.dashGhosts.length) {
        ctx.save();
        ctx.font = 'bold 20px "Microsoft YaHei", monospace';
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        for (const g of dave.dashGhosts) {
            ctx.globalAlpha = g.alpha;
            ctx.fillStyle = '#66FFCC';
            ctx.fillText(dave.label, g.x, g.y);
        }
        ctx.restore();
    }
    // 奔跑拖尾（每几帧留一个淡影）
    if (dave.sprinting && !state.gameOver) {
        ctx.save();
        ctx.globalAlpha = 0.25;
        ctx.fillStyle = '#00FF88';
        ctx.font = 'bold 20px "Microsoft YaHei", monospace';
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        const trailX = dave.x - dave.facing * 12;
        ctx.fillText(dave.label, trailX, dave.y - dave.jumpOffset);
        ctx.restore();
    }

    if (dave.ghost) {
        ctx.save();
        ctx.globalAlpha = dave.ghost.alpha;
        ctx.fillStyle = '#004422';
        ctx.font = 'bold 20px "Microsoft YaHei", monospace';
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.fillText(dave.label, dave.ghost.x, dave.ghost.y);
        ctx.restore();
    }

    // 胜利弹跳偏移
    let bounceY = 0;
    if (state.gameOver && state.victory) {
        bounceY = -Math.abs(Math.sin(dave.victoryBounce * 6)) * 18;
    }

    const y = dave.y - dave.jumpOffset + bounceY;
    const drawX = dave.x + dave.recoil;

    ctx.save();

    // 阵亡：绕自身中心旋转
    if (state.gameOver && !state.victory) {
        ctx.translate(drawX, y);
        ctx.rotate(dave.deathRot);
        ctx.translate(-drawX, -y);
        ctx.fillStyle = '#888';
    } else {
        ctx.fillStyle = dave.hurtFlash > 0 ? '#FF4444' : dave.color;
    }

    ctx.font = 'bold 20px "Microsoft YaHei", monospace';
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    if (dave.isJumping) {
        ctx.shadowColor = '#00FF88';
        ctx.shadowBlur = 12;
    }
    if (state.gameOver && state.victory) {
        ctx.shadowColor = '#FFD700';
        ctx.shadowBlur = 16;
    }
    ctx.fillText(dave.label, drawX, y);
    ctx.restore();

    // 跳跃提示字
    if (dave.isJumping && dave.jumpOffset > 40) {
        ctx.fillStyle = '#88FFAA';
        ctx.font = '12px "Microsoft YaHei", monospace';
        ctx.textAlign = 'center';
        ctx.fillText('跃！', drawX + 24, y - 14);
    }

    // 胜利姿势：头顶星
    if (state.gameOver && state.victory) {
        ctx.fillStyle = '#FFD700';
        ctx.font = 'bold 14px Consolas, monospace';
        ctx.textAlign = 'center';
        ctx.fillText('★', drawX, y - 22);
    }

    // 挥砍动画：在戴夫身前画一个弧形，中心是武器名首字
    if (dave.swingTimer > 0 && dave.swingWeapon) {
        const w = WEAPONS[dave.swingWeapon];
        if (w) {
            const t = dave.swingTimer / 0.22;   // 1 → 0
            const reach = (w.reach || 40) * (1 - t * 0.3);
            const arc = w.arc || Math.PI * 0.6;
            const cx = drawX + Math.cos(dave.swingDir) * reach * 0.6;
            const cy = y + Math.sin(dave.swingDir) * reach * 0.6;

            ctx.save();
            ctx.globalAlpha = t * 0.9;
            ctx.strokeStyle = w.color;
            ctx.lineWidth = 2;
            ctx.shadowColor = w.color;
            ctx.shadowBlur = 8;
            ctx.beginPath();
            ctx.arc(drawX, y, reach, dave.swingDir - arc / 2, dave.swingDir + arc / 2);
            ctx.stroke();
            // 武器字（第一个字符）
            ctx.globalAlpha = t;
            ctx.fillStyle = w.color;
            ctx.font = 'bold 16px "Microsoft YaHei", monospace';
            ctx.textAlign = 'center';
            ctx.textBaseline = 'middle';
            ctx.fillText(w.name.charAt(0), cx, cy);
            ctx.restore();
        }
    }

    // 格挡：盾牌
    if (dave.guarding) {
        const isPerfect = inPerfectGuard();
        const face = dave.guardFacing;
        ctx.save();
        ctx.translate(drawX, y);
        ctx.rotate(face);
        // 盾牌形状：一小段弧
        ctx.strokeStyle = isPerfect ? '#FFEE66' : '#88CCFF';
        ctx.lineWidth = isPerfect ? 4 : 3;
        ctx.shadowColor = isPerfect ? '#FFEE66' : '#88CCFF';
        ctx.shadowBlur = isPerfect ? 16 : 8;
        ctx.beginPath();
        ctx.arc(24, 0, 12, -Math.PI * 0.55, Math.PI * 0.55);
        ctx.stroke();
        ctx.restore();
    }

    // 完美格挡爆发闪光
    if (dave.perfectFlash > 0) {
        ctx.save();
        ctx.globalAlpha = dave.perfectFlash / 0.4;
        ctx.strokeStyle = '#FFEE66';
        ctx.lineWidth = 3;
        ctx.shadowColor = '#FFEE66';
        ctx.shadowBlur = 20;
        ctx.beginPath();
        ctx.arc(drawX, y, 26 + (1 - dave.perfectFlash / 0.4) * 20, 0, Math.PI * 2);
        ctx.stroke();
        ctx.restore();
    }
}

function drawOverlays() {
    drawProgressBar();

    if (!state.waveActive && !state.gameOver && state.wave <= state.maxWave) {
        ctx.save();
        ctx.fillStyle = 'rgba(255,255,255,0.5)';
        ctx.font = '14px "Microsoft YaHei", monospace';
        ctx.textAlign = 'right';
        ctx.textBaseline = 'top';
        ctx.fillText(`下一波: ${Math.ceil(state.waveTimer)}s`, FIELD.right - 8, FIELD.top - 22);
        ctx.restore();
    }
    if (state.gameOver) {
        ctx.fillStyle = 'rgba(0,0,0,0.75)';
        ctx.fillRect(0, 0, W, H);
        ctx.fillStyle = state.victory ? '#00FF00' : '#FF3333';
        ctx.font = 'bold 48px "Microsoft YaHei", monospace';
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.fillText(state.victory ? '胜  利' : '失  败', W / 2, H / 2 - 20);
        ctx.fillStyle = '#AAA';
        ctx.font = '16px "Microsoft YaHei", monospace';
        ctx.fillText('刷新页面重开一局', W / 2, H / 2 + 30);
    }
}

// ---------- 关卡进度条（文字版）----------
// 轨道横贴战场顶部。左端 [家] 起点，右端 [旗！] 终点。
// 每波结束标 [旗]。当前进度头 [僵] 随累计击杀移动。
function drawProgressBar() {
    const barLeft = FIELD.left + 40;
    const barRight = FIELD.right - 40;
    const barY = 20;                    // 顶栏上方
    const totalKills = computeTotalKills();
    const progress = totalKills > 0 ? Math.min(1, state.killedTotal / totalKills) : 0;

    ctx.save();
    ctx.textBaseline = 'middle';
    ctx.font = '13px "Microsoft YaHei", monospace';

    // 轨道底线
    ctx.strokeStyle = '#222';
    ctx.lineWidth = 2;
    ctx.setLineDash([2, 3]);
    ctx.beginPath();
    ctx.moveTo(barLeft, barY);
    ctx.lineTo(barRight, barY);
    ctx.stroke();
    ctx.setLineDash([]);

    // 已完成部分高亮
    const headX = barLeft + (barRight - barLeft) * progress;
    ctx.strokeStyle = 'rgba(0, 255, 136, 0.5)';
    ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.moveTo(barLeft, barY);
    ctx.lineTo(headX, barY);
    ctx.stroke();

    // 起点 [家]
    ctx.fillStyle = '#00FF88';
    ctx.textAlign = 'center';
    ctx.fillText('家', barLeft - 12, barY);

    // 每波节点 [旗]
    for (let w = 1; w <= state.maxWave; w++) {
        const px = barLeft + (barRight - barLeft) * (w / state.maxWave);
        const passed = w < state.wave || (w === state.wave && !state.waveActive && state.zombies.length === 0);
        const isLast = w === state.maxWave;
        const isCurrent = w === state.wave;

        // 竖短线
        ctx.strokeStyle = passed ? '#00AA55' : (isLast ? '#661111' : '#333');
        ctx.lineWidth = 1;
        ctx.beginPath();
        ctx.moveTo(px, barY - 4);
        ctx.lineTo(px, barY + 4);
        ctx.stroke();

        // 旗
        let flagColor, flagText;
        if (isLast) {
            flagColor = passed ? '#00FF88' : '#FF3333';
            flagText = '旗！';
        } else {
            flagColor = passed ? '#00AA55' : (isCurrent ? '#FFD700' : '#555');
            flagText = '旗';
        }
        ctx.fillStyle = flagColor;
        ctx.font = (isCurrent || isLast) ? 'bold 12px "Microsoft YaHei", monospace' : '11px "Microsoft YaHei", monospace';
        ctx.fillText(flagText, px, barY - 12);
    }

    // 进度头 [僵]
    if (!state.gameOver || state.victory) {
        ctx.fillStyle = '#FFFFFF';
        ctx.shadowColor = '#00FF88';
        ctx.shadowBlur = 8;
        ctx.font = 'bold 14px "Microsoft YaHei", monospace';
        ctx.textAlign = 'center';
        ctx.fillText('僵', headX, barY);
        ctx.shadowBlur = 0;
    }

    // 右下角小字：击杀数 / 总数
    ctx.fillStyle = '#666';
    ctx.font = '10px Consolas, monospace';
    ctx.textAlign = 'right';
    ctx.fillText(`${state.killedTotal} / ${totalKills}`, barRight + 8, barY + 10);

    ctx.restore();
}

// 全关总僵尸数（预估，用于进度条比例）
function computeTotalKills() {
    let total = 0;
    for (let w = 1; w <= state.maxWave; w++) {
        total += Math.max(1, Math.round((3 + w * 2) * DIFFICULTY.countMul));
    }
    return total;
}

// ---------- HUD 更新 ----------
function updateHUD() {
    sunValueEl.textContent = Math.floor(state.sun);
    waveValueEl.textContent = state.wave;
    hpValueEl.textContent = dave.hp;
    // 多人：显示第二玩家血量
    const hp2Bar = document.getElementById('hp2-display');
    if (hp2Bar) {
        if (state.mp.active) {
            hp2Bar.classList.remove('hidden');
            const hp2Val = document.getElementById('hp2-value');
            if (hp2Val) hp2Val.textContent = dave2.hp;
        } else {
            hp2Bar.classList.add('hidden');
        }
    }
    cardEls.forEach((el, i) => {
        const key = CARD_ORDER[i];
        const def = PLANTS[key];
        const cd = state.cooldowns[key];
        const cheap = state.sun >= def.cost;
        el.classList.toggle('disabled', cd > 0 || !cheap);
        if (cd > 0) {
            el.classList.add('cooling');
            const pct = (cd / def.cooldown) * 100;
            el.style.setProperty('--cd', pct + '%');
        } else {
            el.classList.remove('cooling');
            el.style.setProperty('--cd', '0%');
        }
    });
    // 武器状态条
    const wBar = document.getElementById('weapon-display');
    if (wBar) {
        const wk = dave.currentWeapon;
        if (!wk || wk === 'shovel') {
            // 只有铲子的话不显示武器耐久（无限耐久）；未装备武器也隐藏
            const showShovel = wk === 'shovel' && !dave.equippedWeapon;
            wBar.classList.toggle('hidden', !showShovel);
            if (showShovel) {
                document.getElementById('weapon-name').textContent = '铲子';
                const durEl = document.getElementById('weapon-dur');
                durEl.textContent = '∞';
                durEl.className = 'w-dur';
            }
        } else {
            wBar.classList.remove('hidden');
            const w = WEAPONS[wk];
            document.getElementById('weapon-name').textContent = w?.name || wk;
            const dur = dave.equippedDurability || 0;
            const cap = weaponDurCap(wk, dave.equippedLevel || 1);
            const durEl = document.getElementById('weapon-dur');
            durEl.textContent = `${dur}/${cap}`;
            durEl.className = 'w-dur' + (dur === 0 ? ' zero' : (dur / cap < 0.25 ? ' low' : ''));
        }
    }

    // 动作条：奔跑 / 闪避 / 格挡
    updateActionSlot('act-sprint', dave.sprinting, 0, 0);
    updateActionSlot('act-dash',   dave.dashing,   dave.dashCooldown,  ACTION.dashCooldown);
    updateActionSlot('act-guard',  dave.guarding,  dave.guardCooldown, ACTION.guardCooldown);
}

function updateActionSlot(id, active, cd, cdMax) {
    const el = document.getElementById(id);
    if (!el) return;
    el.classList.toggle('active', !!active);
    if (!active && cd > 0 && cdMax > 0) {
        el.classList.add('cooling');
        el.classList.remove('ready');
        el.style.setProperty('--cd', (cd / cdMax * 100) + '%');
    } else {
        el.classList.remove('cooling');
        el.style.setProperty('--cd', '0%');
        if (!active) el.classList.add('ready');
        else el.classList.remove('ready');
    }
}

// ============================================================
// 难度调整面板：预设 + 6 滑块，实时生效
// ============================================================
const settingsModal = document.getElementById('settings-modal');
const settingsBtn = document.getElementById('settings-btn');
const settingsClose = document.getElementById('settings-close');
const settingsReset = document.getElementById('settings-reset');
const presetBtns = document.querySelectorAll('.preset');

// 每项滑块的绑定表：滑块 id、显示 id、DIFFICULTY 键、格式化函数
const SLIDER_BINDS = [
    { s: 's-hp',       v: 'v-hp',       key: 'hpMul',       fmt: v => `${(+v).toFixed(1)}×` },
    { s: 's-speed',    v: 'v-speed',    key: 'speedMul',    fmt: v => `${(+v).toFixed(1)}×` },
    { s: 's-count',    v: 'v-count',    key: 'countMul',    fmt: v => `${(+v).toFixed(1)}×` },
    { s: 's-interval', v: 'v-interval', key: 'intervalMul', fmt: v => `${(+v).toFixed(1)}×` },
    { s: 's-rest',     v: 'v-rest',     key: 'restMul',     fmt: v => `${(+v).toFixed(1)}×` },
    { s: 's-sun',      v: 'v-sun',      key: 'initialSun',  fmt: v => `${v}`,      isInt: true },
];

// 面板输入框防止吞掉游戏键
document.querySelectorAll('#settings-modal input, #settings-modal button').forEach(el => {
    el.addEventListener('focus', () => { inputFocused = true; });
    el.addEventListener('blur', () => { inputFocused = false; });
});

// 打开/关闭（旧难度面板已从 UI 移除，做 null 兼容以保留同步函数）
if (settingsBtn) {
    settingsBtn.addEventListener('click', () => {
        if (settingsModal) settingsModal.classList.remove('hidden');
        syncSlidersFromDifficulty();
    });
}
if (settingsClose) {
    settingsClose.addEventListener('click', () => {
        if (settingsModal) settingsModal.classList.add('hidden');
    });
}
if (settingsModal) {
    settingsModal.addEventListener('click', (e) => {
        if (e.target === settingsModal) settingsModal.classList.add('hidden');
    });
}

// 从 DIFFICULTY 反向同步到 UI（预设切换、重置时用）
function syncSlidersFromDifficulty() {
    SLIDER_BINDS.forEach(b => {
        const sEl = document.getElementById(b.s);
        const vEl = document.getElementById(b.v);
        if (!sEl || !vEl) return;
        sEl.value = DIFFICULTY[b.key];
        vEl.textContent = b.fmt(sEl.value);
    });
}

// 滑块滑动即时生效
SLIDER_BINDS.forEach(b => {
    const sEl = document.getElementById(b.s);
    const vEl = document.getElementById(b.v);
    if (!sEl || !vEl) return;
    sEl.addEventListener('input', () => {
        const raw = sEl.value;
        DIFFICULTY[b.key] = b.isInt ? parseInt(raw, 10) : parseFloat(raw);
        vEl.textContent = b.fmt(raw);
        // 高亮"自定义"：清除所有 preset 的 active
        presetBtns.forEach(p => p.classList.remove('active'));
    });
});

// 预设点击
presetBtns.forEach(btn => {
    btn.addEventListener('click', () => {
        const name = btn.dataset.preset;
        const preset = DIFFICULTY_PRESETS[name];
        if (!preset) return;
        Object.assign(DIFFICULTY, preset);
        presetBtns.forEach(p => p.classList.toggle('active', p === btn));
        syncSlidersFromDifficulty();
        log(`难度: ${btn.textContent}`);
    });
});

// 重置默认
// 重置默认（旧面板已移除，做兼容）
if (settingsReset) {
    settingsReset.addEventListener('click', () => {
        Object.assign(DIFFICULTY, DIFFICULTY_PRESETS.normal);
        presetBtns.forEach(p => p.classList.toggle('active', p.dataset.preset === 'normal'));
        syncSlidersFromDifficulty();
        log('难度已重置为普通');
    });
}

// 启动时应用初始阳光
state.sun = DIFFICULTY.initialSun;
syncSlidersFromDifficulty();

// 注意：主循环由 startGame() 触发，此处不自动启动
