// ============================================================
// 文字版植物大战僵尸 · 完整版
// 黑屏 + 5 行战场 + 戴夫自由移动 + 跳跃 + 行切换
// + 自由种植 + 豌豆射击 + 僵尸生成推进 + 阳光经济 + 波次系统
// ============================================================

const canvas = document.getElementById('game');
const ctx = canvas.getContext('2d');
const W = canvas.width;
const H = canvas.height;

// ---------- 战场配置 ----------
const FIELD = {
    left: 60,
    right: W - 40,
    top: 40,
    bottom: H - 40,
    rows: 5,
};
FIELD.rowHeight = (FIELD.bottom - FIELD.top) / FIELD.rows;

// 启用行索引数组（0-based），默认全部 5 行；关卡启动时会覆盖
// 例如 1-1 = [2]，1-2 = [1,2,3]，1-3+ = [0,1,2,3,4]
FIELD.activeRows = [0, 1, 2, 3, 4];
function isRowActive(r) { return FIELD.activeRows.includes(r); }
function randomActiveRow() {
    const arr = FIELD.activeRows;
    return arr[Math.floor(Math.random() * arr.length)];
}

function rowY(i) {
    return FIELD.top + FIELD.rowHeight * (i + 0.5);
}
// 由像素 y 反推当前所在行（用于种植归属、受击判定）
function yToRow(y) {
    const r = Math.floor((y - FIELD.top) / FIELD.rowHeight);
    return Math.max(0, Math.min(FIELD.rows - 1, r));
}

// ---------- 戴夫 ----------
const dave = {
    x: FIELD.left + 40,
    y: rowY(2),              // 像素级 Y 坐标（自由移动）
    jumpOffset: 0,
    vy: 0,
    isJumping: false,
    jumpCooldown: 0,
    speed: 220,              // 水平速度
    speedY: 180,             // 垂直速度（略慢于水平，手感更稳）
    hp: 3,
    hurtFlash: 0,
    color: '#00FF88',
    label: '戴夫',
    facing: 1,               // 面朝：1右 -1左
    facingAngle: 0,          // 精确朝向（弧度，用于挥砍方向）
    ghost: null,
    _damageAcc: 0,
    // 武器与动作
    currentWeapon: null,        // 当前装备武器 key，如 'shovel'
    weaponCooldown: 0,          // 武器攻击冷却
    swingTimer: 0,              // 挥砍动画剩余时间
    swingDir: 0,                // 挥砍方向（弧度）
    swingWeapon: null,          // 本次挥砍的武器 key
    recoil: 0,                  // 受击后仰位移（x 方向）
    victoryBounce: 0,           // 胜利弹跳计时
    deathRot: 0,                // 阵亡旋转角度

    // ---- 动作系统 ----
    sprinting: false,           // 是否按住 Shift 奔跑
    sprintMul: 1.65,            // 奔跑速度倍率
    // 闪避（瞬移带无敌帧）
    dashing: false,
    dashTimer: 0,
    dashDir: { x: 0, y: 0 },
    dashCooldown: 0,
    dashGhosts: [],             // 残影粒子 { x,y,alpha }
    // 无敌帧（闪避/受击后短保护）
    invuln: 0,
    // 格挡
    guarding: false,            // E 按住
    guardTimer: 0,              // 从按下开始的时间（用于完美窗口判定）
    guardCooldown: 0,           // 收盾后小 CD，避免瞬闪滥用
    perfectFlash: 0,            // 完美格挡视觉反馈
    guardFacing: 0,             // 开盾瞬间的朝向（弧度）

    get row() { return yToRow(this.y); },
};

