// ============================================================
// 账户 / 登录系统
// ============================================================
(function initAuth() {
    if (!window.Net) return;

    const loginScreen  = document.getElementById('login-screen');
    const menuScreen   = document.getElementById('menu-screen');
    const tabs         = document.querySelectorAll('.login-tab');
    const submitBtn    = document.getElementById('login-submit');
    const guestBtn     = document.getElementById('login-guest');
    const usernameEl   = document.getElementById('login-username');
    const passwordEl   = document.getElementById('login-password');
    const msgEl        = document.getElementById('login-msg');
    const accountsEl   = document.getElementById('login-accounts');
    const userNameSpan = document.getElementById('user-name');
    const btnLogout    = document.getElementById('btn-logout');

    let mode = 'login'; // 'login' | 'register'

    function setMsg(text, ok) {
        msgEl.textContent = text || '\u00a0';
        msgEl.classList.toggle('ok', !!ok);
    }
    function setMode(next) {
        mode = next;
        tabs.forEach(t => t.classList.toggle('active', t.dataset.tab === mode));
        submitBtn.textContent = (mode === 'login') ? '登  录' : '注 册 并 登 录';
        setMsg('');
    }
    function renderAccounts() {
        const list = Net.auth.listAccounts();
        if (!list.length) {
            accountsEl.innerHTML = '<div class="acc-title">尚无本地账户，请先注册</div>';
            return;
        }
        accountsEl.innerHTML =
            '<div class="acc-title">已有账户 (点击填入):</div>' +
            list.map(u => `<span class="acc-item" data-u="${u}">${u}</span>`).join('');
        accountsEl.querySelectorAll('.acc-item').forEach(el => {
            el.addEventListener('click', () => {
                usernameEl.value = el.dataset.u;
                passwordEl.focus();
            });
        });
    }

    tabs.forEach(t => t.addEventListener('click', () => setMode(t.dataset.tab)));

    async function submit() {
        const u = usernameEl.value.trim();
        const p = passwordEl.value;
        setMsg('处理中...');
        submitBtn.disabled = true;
        try {
            let res;
            if (mode === 'register') {
                res = await Net.auth.register(u, p);
                if (!res.ok) { setMsg(res.error); return; }
                res = await Net.auth.login(u, p);
            } else {
                res = await Net.auth.login(u, p);
            }
            if (!res.ok) { setMsg(res.error); return; }
            setMsg('登录成功，正在进入...', true);
            // 用户命名空间变了，最简单可靠的做法是刷新页面重新加载存档
            setTimeout(() => location.reload(), 250);
        } finally {
            submitBtn.disabled = false;
        }
    }
    submitBtn.addEventListener('click', submit);
    [usernameEl, passwordEl].forEach(el => {
        el.addEventListener('keydown', (e) => {
            if (e.key === 'Enter') submit();
        });
    });

    guestBtn.addEventListener('click', () => {
        // 访客：不建立会话，直接进主菜单（用 __guest__ 命名空间）
        showScreen('menu');
        refreshUserBar();
    });

    btnLogout.addEventListener('click', () => {
        if (!Net.auth.isLoggedIn()) {
            // 访客状态直接回登录屏
            showScreen('login');
            renderAccounts();
            return;
        }
        if (!confirm('确认登出当前账户？')) return;
        Net.auth.logout();
        location.reload();
    });

    function refreshUserBar() {
        const u = Net.currentUser();
        userNameSpan.textContent = u || '访客';
        if (heroNameEl && !heroNameEl.dataset.userEdited) {
            heroNameEl.value = (u || '戴夫').slice(0, 6);
        }
        btnLogout.textContent = u ? '登出' : '切换账户';
    }
    if (heroNameEl) {
        heroNameEl.addEventListener('input', () => { heroNameEl.dataset.userEdited = '1'; });
    }

    // 启动路由：已登录 -> 主菜单；未登录 -> 登录屏
    if (Net.auth.isLoggedIn()) {
        showScreen('menu');
    } else {
        showScreen('login');
    }
    renderAccounts();
    refreshUserBar();
})();

// 关卡网格
let selectedLevel = null;
function renderLevelGrid() {
    // 顺便刷新货币显示
    refreshCurrencyUI();
    const grid = document.getElementById('level-grid');
    grid.innerHTML = '';
    LEVELS.forEach((lv, idx) => {
        const cleared = saveData.cleared.includes(lv.id);
        const prevCleared = idx === 0 || saveData.cleared.includes(LEVELS[idx - 1].id);
        const locked = !prevCleared;
        const card = document.createElement('div');
        card.className = 'level-card' + (cleared ? ' cleared' : '') + (locked ? ' locked' : '');
        card.innerHTML = `
            <div class="lv-code">${lv.id}</div>
            <div class="lv-name">${lv.name}</div>
        `;
        if (!locked) {
            card.addEventListener('click', () => selectLevel(lv, card));
        }
        grid.appendChild(card);
    });
    // 默认选中第一个未通关的关卡（或最后一关）
    const firstUncleared = LEVELS.find(l => !saveData.cleared.includes(l.id)) || LEVELS[0];
    const idx = LEVELS.indexOf(firstUncleared);
    const cards = grid.querySelectorAll('.level-card');
    if (cards[idx] && !cards[idx].classList.contains('locked')) {
        selectLevel(firstUncleared, cards[idx]);
    }
}

function selectLevel(lv, cardEl) {
    selectedLevel = lv;
    document.querySelectorAll('.level-card').forEach(c => c.classList.remove('active'));
    if (cardEl) cardEl.classList.add('active');
    const zombieNames = [...new Set(lv.zombiePool)].map(k => ZOMBIES[k].name).join(' · ');
    const cardNames = lv.allowedCards.map(k => PLANTS[k].name).join(' · ');
    document.getElementById('detail-title').innerHTML =
        `<span class="g">${lv.id}</span>　${lv.name}　　波次 <span class="k">${lv.waves}</span>`;
    document.getElementById('detail-body').innerHTML =
        `${lv.desc}<br>
         初始阳光: <span class="k">${lv.firstSun}</span> · 敌人: ${zombieNames}<br>
         可用: ${cardNames}`;
}

document.getElementById('btn-play').addEventListener('click', () => {
    if (selectedLevel) startGame(selectedLevel);
});
document.getElementById('btn-back-menu').addEventListener('click', () => {
    showScreen('menu');
});

// 退出关卡回菜单
document.getElementById('btn-quit-level').addEventListener('click', () => {
    if (confirm('放弃当前关卡？')) {
        stopGame();
        showScreen('menu');
        refreshContinueBtn();
    }
});

// ---------- 启动关卡 ----------
let currentLevel = null;
let gameRunning = false;
let rafId = 0;

function startGame(level) {
    currentLevel = level;

    // 步骤 1：先应用玩家在选关屏选的难度（简单/普通/困难/地狱）
    const basePreset = DIFFICULTY_PRESETS[currentDifficulty] || DIFFICULTY_PRESETS.normal;
    Object.assign(DIFFICULTY, basePreset);

    // 步骤 2：叠加关卡专属难度修正（乘法叠加，让关卡节奏保留）
    if (level.diffMod) {
        DIFFICULTY.hpMul       *= (level.diffMod.hpMul ?? 1);
        DIFFICULTY.speedMul    *= (level.diffMod.speedMul ?? 1);
        DIFFICULTY.countMul    *= (level.diffMod.countMul ?? 1);
        DIFFICULTY.intervalMul *= (level.diffMod.intervalMul ?? 1);
        DIFFICULTY.restMul     *= (level.diffMod.restMul ?? 1);
    }
    syncSlidersFromDifficulty();

    // 重置游戏状态
    state.sun = level.firstSun;
    state.wave = 1;
    state.maxWave = level.waves;
    state.selectedCard = -1;
    state.plants.length = 0;
    state.zombies.length = 0;
    state.bullets.length = 0;
    state.suns.length = 0;
    state.effects.length = 0;
    state.pickups.length = 0;
    state.tempCards.length = 0;
    // 本局奖励累计（结算显示用）
    state.roundRewards = { silver: 0, gold: 0, gem: 0, fragments: {}, wfrags: {} };
    state.waveTimer = 8;
    state.waveActive = false;
    state.zombiesInWave = 0;
    state.zombiesSpawned = 0;
    state.naturalSunTimer = 8;
    state.gameOver = false;
    state.victory = false;
    state.time = 0;
    state.killedTotal = 0;
    CARD_ORDER.forEach(k => state.cooldowns[k] = 0);

    // 应用关卡通道数
    FIELD.activeRows = (level.rows && level.rows.length > 0) ? level.rows.slice() : [0, 1, 2, 3, 4];
    const middleRow = FIELD.activeRows[Math.floor(FIELD.activeRows.length / 2)];

    // 戴夫复位
    dave.x = FIELD.left + 40;
    dave.y = rowY(middleRow);
    dave.jumpOffset = 0;
    dave.vy = 0;
    dave.isJumping = false;
    dave.jumpCooldown = 0;
    dave.hp = 3;
    dave.hurtFlash = 0;
    dave.ghost = null;
    dave._damageAcc = 0;
    dave.weaponCooldown = 0;
    dave.swingTimer = 0;
    dave.recoil = 0;
    dave.victoryBounce = 0;
    dave.deathRot = 0;
    dave.facingAngle = 0;
    // 多人：远端玩家复位（房主端才推进；客人靠 snapshot 覆盖）
    if (state.mp.active && state.mp.role === 'host') {
        dave2.x = FIELD.left + 80;
        dave2.y = rowY(middleRow);
        dave2.jumpOffset = 0; dave2.vy = 0; dave2.isJumping = false;
        dave2.hp = 3; dave2.hurtFlash = 0; dave2._damageAcc = 0;
        dave2.weaponCooldown = 0; dave2.swingTimer = 0;
        dave2.dashing = false; dave2.dashCooldown = 0;
        dave2.guarding = false; dave2.guardCooldown = 0;
        dave2.invuln = 0; dave2.perfectFlash = 0;
        dave2.currentWeapon = 'dagger';
        dave2.label = 'P2'; dave2.color = '#66FFCC';
    }
    // 标签：房主自己是 P1，客人自己是 P2（客人的 label 会在 mp start 事件里被改）
    if (state.mp.active && state.mp.role === 'host') {
        dave.label = 'P1'; dave.color = '#00FF88';
    }
    // 动作系统复位
    dave.sprinting = false;
    dave.dashing = false;   dave.dashTimer = 0;    dave.dashCooldown = 0;
    dave.dashGhosts = [];
    dave.guarding = false;  dave.guardTimer = 0;   dave.guardCooldown = 0;
    dave.perfectFlash = 0;
    dave.invuln = 0;
    // 装备设定：
    //  1) 铲子解锁后无条件常驻（无限耐久）
    //  2) 玩家在武器库装备的武器带耐久上限，本局用尽即不可用
    dave.currentWeapon = isShovelUnlocked() ? 'shovel' : null;
    const eq = META.weapons?.equipped;
    if (eq && META.weapons.unlocked[eq]) {
        const lv = META.weapons.levels[eq] || 1;
        dave.equippedWeapon = eq;
        dave.equippedLevel  = lv;
        dave.equippedDurability = weaponDurCap(eq, lv);
        // 装备的武器优先于铲子成为出手武器
        dave.currentWeapon = eq;
    } else {
        dave.equippedWeapon = null;
        dave.equippedLevel  = 1;
        dave.equippedDurability = 0;
    }

    // 关卡可用卡片：禁用不允许的
    applyAllowedCards(level.allowedCards);

    // 关卡专属僵尸池：临时改写 spawnZombie 的类型选择
    state._zombiePool = level.zombiePool;

    // UI 顶栏
    document.getElementById('level-tag').textContent = level.id;
    document.getElementById('wave-max').textContent = level.waves;
    document.getElementById('sun-value').textContent = state.sun;
    document.getElementById('hp-value').textContent = dave.hp;

    // 存档
    saveData.lastLevel = level.id;
    writeSave(saveData);
    refreshContinueBtn();

    // 切屏
    showScreen('game');

    // 启动主循环
    if (!gameRunning) {
        gameRunning = true;
        lastTime = performance.now();
        rafId = requestAnimationFrame(loop);
    }

    log(`${level.id} · ${level.name} — 准备开始`);
}

function stopGame() {
    gameRunning = false;
    if (rafId) cancelAnimationFrame(rafId);
    rafId = 0;
    // 退出游戏时断开联机会话
    if (state.mp.active) {
        state.mp.active = false;
        state.mp.role = null;
        state.mp.remoteInput = null;
        try { Net.mp.close(true); } catch {}
        // 恢复标签
        dave.label = '戴夫'; dave.color = '#00FF88';
    }
}

function applyAllowedCards(allowed) {
    cardEls.forEach((el, i) => {
        const key = CARD_ORDER[i];
        if (allowed.includes(key)) {
            el.style.display = '';
            el.classList.remove('locked');
        } else {
            el.style.display = 'none';
        }
    });
}

// 让 spawnZombie 使用关卡的 zombiePool（在 spawnZombie 内部已处理）

// 主循环已在原函数内处理暂停逻辑

// ============================================================
// 植物图鉴 & 升级 UI
// ============================================================
const almanacScreen = document.getElementById('almanac-screen');
const almanacGrid = document.getElementById('almanac-grid');
const btnAlmanac = document.getElementById('btn-almanac');
const btnBackMenuAlmanac = document.getElementById('btn-back-menu-almanac');
const btnUpgrade = document.getElementById('btn-upgrade');
const btnGiveFrags = document.getElementById('btn-give-frags');

// 植物碎片键名（与 META.fragments 对应）
const PLANT_FRAG_LABEL = {
    sunflower:  '葵片',
    peashooter: '豌片',
    wallnut:    '果片',
    cherry:     '桃片',
};

let almanacSelected = 'peashooter';

// 打开图鉴
btnAlmanac.addEventListener('click', () => {
    renderAlmanac();
    showScreen('almanac');
});
btnBackMenuAlmanac.addEventListener('click', () => {
    showScreen('menu');
});

// 领取试用碎片（调试用）
btnGiveFrags.addEventListener('click', () => {
    CARD_ORDER.forEach(k => {
        META.fragments[k] = (META.fragments[k] || 0) + 20;
    });
    saveFragments(META.fragments);
    renderAlmanac();
});

// 升级按钮
btnUpgrade.addEventListener('click', () => {
    if (!almanacSelected) return;
    const kind = almanacSelected;
    const lv = META.levels[kind] || 1;
    const next = nextLevelInfo(lv);
    if (!next) return;
    const need = next.cumulative - (levelInfo(lv).cumulative);
    const owned = META.fragments[kind] || 0;
    if (owned < need) return;
    META.fragments[kind] = owned - need;
    META.levels[kind] = lv + 1;
    saveFragments(META.fragments);
    saveLevels(META.levels);
    renderAlmanac();
    // 简短提示
    document.getElementById('a-detail-name').classList.add('lvup-flash');
    setTimeout(() => document.getElementById('a-detail-name').classList.remove('lvup-flash'), 600);
});

function renderAlmanac() {
    // 卡片网格
    almanacGrid.innerHTML = '';
    CARD_ORDER.forEach(kind => {
        const def = PLANTS[kind];
        const lv = META.levels[kind] || 1;
        const info = levelInfo(lv);
        const next = nextLevelInfo(lv);
        const owned = META.fragments[kind] || 0;
        const curBase = info.cumulative;
        const nextBase = next ? next.cumulative : info.cumulative;
        const need = next ? next.cumulative - info.cumulative : 0;
        const pct = next ? Math.min(100, Math.floor((owned / need) * 100)) : 100;

        const card = document.createElement('div');
        card.className = 'plant-card' + (almanacSelected === kind ? ' active' : '');
        card.style.color = def.color;
        card.innerHTML = `
            <span class="p-lv ${lv >= 5 ? 'awakened' : ''}">${info.label}</span>
            <div class="p-name">${def.name}</div>
            <div class="p-frag">${PLANT_FRAG_LABEL[kind]} <b>${owned}</b>${next ? ` / ${need}` : ''}</div>
            <div class="p-bar"><div class="p-bar-inner" style="width: ${pct}%"></div></div>
        `;
        card.addEventListener('click', () => {
            almanacSelected = kind;
            renderAlmanac();
        });
        almanacGrid.appendChild(card);
    });

    // 详情面板
    updateAlmanacDetail();

    // 底栏碎片
    CARD_ORDER.forEach(k => {
        const el = document.getElementById(`frag-${k}`);
        if (el) el.textContent = META.fragments[k] || 0;
    });
}

function updateAlmanacDetail() {
    if (!almanacSelected) return;
    const kind = almanacSelected;
    const def = PLANTS[kind];
    const lv = META.levels[kind] || 1;
    const info = levelInfo(lv);
    const next = nextLevelInfo(lv);
    const owned = META.fragments[kind] || 0;
    const spec = PLANT_LEVEL_STAT[kind];

    // 名字
    const nameEl = document.getElementById('a-detail-name');
    nameEl.textContent = def.name;
    nameEl.style.color = def.color;
    nameEl.style.textShadow = `0 0 12px ${def.color}`;

    // 属性对比（当前 → 下一级）
    const statEl = document.getElementById('a-detail-stat');
    statEl.innerHTML = '';
    const stats = getAlmanacStats(kind, info.mul, next ? next.mul : info.mul);
    stats.forEach(s => {
        const row = document.createElement('div');
        row.className = 'stat-line';
        row.innerHTML = `
            <span>${s.label}</span>
            <span>
                <span class="cur">${s.cur}</span>
                ${next ? `<span class="next">→ ${s.next}</span>` : `<span class="max-tag">★ 满级</span>`}
            </span>
        `;
        statEl.appendChild(row);
    });

    // 描述
    document.getElementById('a-detail-desc').textContent = getAlmanacDesc(kind, lv);

    // 等级标签
    const tagEl = document.getElementById('a-lv-tag');
    tagEl.textContent = info.label;
    tagEl.style.color = lv >= 5 ? '#FF88DD' : '#FFD700';

    // 进度条
    const need = next ? next.cumulative - info.cumulative : 0;
    const pct = next ? Math.min(100, Math.floor((owned / need) * 100)) : 100;
    document.getElementById('a-lv-bar-inner').style.width = pct + '%';
    document.getElementById('a-lv-bar-text').textContent = next
        ? `${owned} / ${need} ${PLANT_FRAG_LABEL[kind]}`
        : `★ 已觉醒（Lv 5 最高等级）`;

    // 升级按钮
    const canUpgrade = next && owned >= need;
    btnUpgrade.disabled = !canUpgrade;
    if (!next) {
        btnUpgrade.textContent = '已 觉 醒';
    } else if (canUpgrade) {
        btnUpgrade.textContent = `升级 Lv ${lv + 1} · 消耗 ${need} ${PLANT_FRAG_LABEL[kind]}`;
    } else {
        btnUpgrade.textContent = `还差 ${need - owned} ${PLANT_FRAG_LABEL[kind]}`;
    }
}

// 生成图鉴属性表（当前值 / 下一级值）
function getAlmanacStats(kind, curMul, nextMul) {
    const def = PLANTS[kind];
    switch (kind) {
        case 'sunflower':
            return [
                { label: '每颗阳光', cur: '25', next: '25' },
                { label: '产阳光周期', cur: (24 / curMul).toFixed(1) + 's', next: (24 / nextMul).toFixed(1) + 's' },
                { label: '每分钟产量', cur: Math.round(60 / (24 / curMul) * 25), next: Math.round(60 / (24 / nextMul) * 25) },
            ];
        case 'peashooter':
            return [
                { label: '豌豆伤害', cur: Math.round(def.bulletDamage * curMul), next: Math.round(def.bulletDamage * nextMul) },
                { label: '射速', cur: def.fireInterval.toFixed(2) + 's', next: def.fireInterval.toFixed(2) + 's' },
                { label: 'DPS', cur: (def.bulletDamage * curMul / def.fireInterval).toFixed(1), next: (def.bulletDamage * nextMul / def.fireInterval).toFixed(1) },
            ];
        case 'wallnut':
            return [
                { label: '血量', cur: Math.round(def.hp * curMul), next: Math.round(def.hp * nextMul) },
                { label: '成本', cur: def.cost, next: def.cost },
            ];
        case 'cherry':
            return [
                { label: '爆炸半径', cur: Math.round(def.blastRadius * curMul) + 'px', next: Math.round(def.blastRadius * nextMul) + 'px' },
                { label: '爆炸伤害', cur: '致命', next: '致命' },
                { label: '成本', cur: def.cost, next: def.cost },
            ];
        default:
            return [];
    }
}

function getAlmanacDesc(kind, lv) {
    const map = {
        sunflower:  '产阳光的主力。种得越多、产越快，前期核心。' + (lv >= 5 ? '【觉醒】产量翻倍！' : ''),
        peashooter: '基础输出植物。一颗豌豆一份伤害。' + (lv >= 5 ? '【觉醒】伤害翻倍，一枪一个！' : ''),
        wallnut:    '肉盾。血厚，能挡住僵尸让后排火力输出。' + (lv >= 5 ? '【觉醒】血量翻倍！' : ''),
        cherry:     '一次性范围炸弹。可清一片僵尸。' + (lv >= 5 ? '【觉醒】爆炸半径翻倍！' : ''),
    };
    return map[kind] || '';
}

// 首次启动赠送 5 个每种碎片（便于陛下先熟悉 UI）
(function initialFragmentGift() {
    const key = 'pvz_txt_first_gift_v1';
    if (localStorage.getItem(key)) return;
    CARD_ORDER.forEach(k => {
        if ((META.fragments[k] || 0) < 5) META.fragments[k] = 5;
    });
    saveFragments(META.fragments);
    try { localStorage.setItem(key, '1'); } catch {}
})();

// ============================================================
// 难度选择器接线（选关屏顶部四个按钮）
// ============================================================
const DIFFICULTY_TIPS = {
    easy:   '简单：敌方弱化，植物攻速 1.35× · 奖励减半',
    normal: '普通：敌方标准 · 奖励标准',
    hard:   '困难：敌方加强 · 奖励 1.5× · 掉率 1.3×',
    hell:   '地狱：敌方强化 · 奖励 2.5× · 掉率 1.8×',
};
function applyDifficulty(name) {
    const preset = DIFFICULTY_PRESETS[name];
    if (!preset) return;
    Object.assign(DIFFICULTY, preset);
    currentDifficulty = name;
    // 高亮按钮
    document.querySelectorAll('.diff-btn').forEach(b => {
        b.classList.toggle('active', b.dataset.diff === name);
    });
    // 更新提示
    const tip = document.getElementById('diff-tip');
    if (tip) tip.textContent = DIFFICULTY_TIPS[name] || '';
}
(function bindDifficultyButtons() {
    document.querySelectorAll('.diff-btn').forEach(btn => {
        btn.addEventListener('click', () => applyDifficulty(btn.dataset.diff));
    });
    // 初始为普通
    applyDifficulty('normal');
})();

// ============================================================
// 结算弹窗按钮接线（返回主页 / 重新游戏 / 下一关）
// ============================================================
(function bindResultButtons() {
    const btnMenu = document.getElementById('btn-result-menu');
    const btnRetry = document.getElementById('btn-result-retry');
    // btn-result-next 在 showResultModal 中动态绑定，因为要用当前关信息

    if (btnMenu) {
        btnMenu.addEventListener('click', () => {
            hideResultModal();
            stopGame();
            showScreen('menu');
            refreshContinueBtn();
        });
    }
    if (btnRetry) {
        btnRetry.addEventListener('click', () => {
            hideResultModal();
            if (currentLevel) {
                startGame(currentLevel);
            }
        });
    }

    // 点击遮罩不关闭结算（避免误触）——但 ESC 键返回主页
    window.addEventListener('keydown', (e) => {
        const modal = document.getElementById('result-modal');
        if (!modal || modal.classList.contains('hidden')) return;
        if (e.key === 'Escape') {
            hideResultModal();
            stopGame();
            showScreen('menu');
            refreshContinueBtn();
        }
    });
})();

// 初始屏由账户系统 initAuth() 决定：已登录进主菜单，未登录进登录屏

// ============================================================
// 武器库：图鉴 · 掉率 · 解锁 · 升级 · 装备
// ============================================================
const armoryGrid    = document.getElementById('armory-grid');
const btnArmory     = document.getElementById('btn-armory');
const btnBackArmory = document.getElementById('btn-back-menu-armory');
const btnWAction    = document.getElementById('btn-w-action');
const btnWEquip     = document.getElementById('btn-w-equip');
const btnGiveWFrag  = document.getElementById('btn-give-wfrags');
let armorySelected  = 'pistol';

// 帮助：某种武器碎片在指定僵尸类型上的估算掉率 (%)
function estimateWfragChance(zombieKind, weaponKey) {
    const t = DROP_TABLE[zombieKind];
    if (!t || !t.wfrag) return 0;
    const weights = WEAPON_FRAG_WEIGHTS[zombieKind] || WEAPON_FRAG_WEIGHTS.normal;
    let total = 0;
    for (const k in weights) total += weights[k];
    const share = (weights[weaponKey] || 0) / total;
    return t.wfrag.chance * share * 100;
}

function renderArmory() {
    refreshCurrencyUI();
    // 卡片网格
    armoryGrid.innerHTML = '';
    WEAPON_ORDER.forEach(kind => {
        const w  = WEAPONS[kind];
        const wm = WEAPON_META[kind];
        const unlocked = !!META.weapons.unlocked[kind];
        const equipped = META.weapons.equipped === kind;
        const lv = META.weapons.levels[kind] || (unlocked ? 1 : 0);
        const owned = META.weaponFrags[kind] || 0;

        let need, pct, tag;
        if (!unlocked) {
            need = wm.unlockCost;
            pct  = Math.min(100, Math.floor((owned / need) * 100));
            tag  = '未解锁';
        } else if (lv < wm.maxLevel) {
            need = wm.perLevel * lv;
            pct  = Math.min(100, Math.floor((owned / need) * 100));
            tag  = 'Lv' + lv;
        } else {
            need = 0;
            pct  = 100;
            tag  = '★ 满级';
        }

        const card = document.createElement('div');
        card.className = 'plant-card'
            + (armorySelected === kind ? ' active' : '')
            + (unlocked ? '' : ' locked')
            + (equipped ? ' equipped-card' : '');
        card.style.color = w.color;
        card.innerHTML = `
            <span class="p-lv ${lv >= wm.maxLevel ? 'awakened' : ''}">${tag}</span>
            <div class="p-name">${w.name}</div>
            <div class="p-frag">${wm.fragLabel} <b>${owned}</b>${need ? ` / ${need}` : ''}</div>
            <div class="p-bar"><div class="p-bar-inner" style="width: ${pct}%"></div></div>
        `;
        card.addEventListener('click', () => {
            armorySelected = kind;
            renderArmory();
        });
        armoryGrid.appendChild(card);
    });

    updateArmoryDetail();

    // 底栏碎片
    WEAPON_ORDER.forEach(k => {
        const el = document.getElementById(`wfrag-${k}`);
        if (el) el.textContent = META.weaponFrags[k] || 0;
    });
}

function updateArmoryDetail() {
    const kind = armorySelected;
    if (!kind) return;
    const w  = WEAPONS[kind];
    const wm = WEAPON_META[kind];
    const unlocked = !!META.weapons.unlocked[kind];
    const equipped = META.weapons.equipped === kind;
    const lv = META.weapons.levels[kind] || (unlocked ? 1 : 0);
    const owned = META.weaponFrags[kind] || 0;
    const mul = weaponMul(Math.max(1, lv));

    // 名字
    const nameEl = document.getElementById('w-detail-name');
    nameEl.textContent = w.name + (unlocked ? '' : '（未解锁）');
    nameEl.style.color = w.color;
    nameEl.style.textShadow = `0 0 12px ${w.color}`;

    // 属性
    const statEl = document.getElementById('w-detail-stat');
    statEl.innerHTML = '';
    const nextLv = lv < wm.maxLevel ? lv + 1 : null;
    const nextMul = nextLv ? weaponMul(nextLv) : mul;
    const rows = getArmoryStats(kind, mul, nextMul, lv, nextLv);
    rows.forEach(s => {
        const row = document.createElement('div');
        row.className = 'stat-line';
        row.innerHTML = `
            <span>${s.label}</span>
            <span>
                <span class="cur">${s.cur}</span>
                ${nextLv ? `<span class="next">→ ${s.next}</span>` : `<span class="max-tag">★ 满级</span>`}
            </span>
        `;
        statEl.appendChild(row);
    });

    // 描述
    document.getElementById('w-detail-desc').textContent = getArmoryDesc(kind);

    // 掉率表（局内使用/观察）
    const dropsEl = document.getElementById('w-drops');
    const rows2 = [];
    ['normal', 'cone', 'bucket'].forEach(z => {
        const p = estimateWfragChance(z, kind);
        const zname = ZOMBIES[z]?.name || z;
        rows2.push(`<div class="drop-row"><span>${zname}</span><b>${p.toFixed(2)}%</b></div>`);
    });
    dropsEl.innerHTML = `<div class="drops-title">局内掉落率 (每只僵尸)</div>` + rows2.join('');

    // 等级标签
    const tagEl = document.getElementById('w-lv-tag');
    tagEl.textContent = unlocked ? (lv >= wm.maxLevel ? '★ 满级' : 'Lv ' + lv) : '未解锁';
    tagEl.style.color = !unlocked ? '#888' : (lv >= wm.maxLevel ? '#FF88DD' : '#FFD700');

    // 进度条
    let need = 0;
    if (!unlocked) need = wm.unlockCost;
    else if (lv < wm.maxLevel) need = wm.perLevel * lv;
    const pct = need ? Math.min(100, Math.floor((owned / need) * 100)) : 100;
    document.getElementById('w-lv-bar-inner').style.width = pct + '%';
    document.getElementById('w-lv-bar-text').textContent = need
        ? `${owned} / ${need} ${wm.fragLabel}`
        : `★ 已满级`;

    // 主动作按钮：解锁 / 升级 / 已满级
    if (!unlocked) {
        const can = owned >= wm.unlockCost;
        btnWAction.disabled = !can;
        btnWAction.textContent = can
            ? `解锁 · 消耗 ${wm.unlockCost} ${wm.fragLabel}`
            : `还差 ${wm.unlockCost - owned} ${wm.fragLabel}`;
    } else if (lv < wm.maxLevel) {
        const cost = wm.perLevel * lv;
        const can = owned >= cost;
        btnWAction.disabled = !can;
        btnWAction.textContent = can
            ? `升级 Lv ${lv + 1} · 消耗 ${cost} ${wm.fragLabel}`
            : `还差 ${cost - owned} ${wm.fragLabel}`;
    } else {
        btnWAction.disabled = true;
        btnWAction.textContent = '已 满 级';
    }

    // 装备按钮
    btnWEquip.classList.toggle('equipped', equipped);
    btnWEquip.disabled = !unlocked;
    btnWEquip.textContent = !unlocked ? '装 备' : (equipped ? '★ 已装备（点击卸下）' : '装 备');
}

function getArmoryStats(kind, mul, nextMul, lv, nextLv) {
    const w  = WEAPONS[kind];
    const wm = WEAPON_META[kind];
    const dCur  = Math.round(w.damage * mul);
    const dNext = Math.round(w.damage * nextMul);
    const cdCur  = (w.fireInterval / mul).toFixed(2);
    const cdNext = (w.fireInterval / nextMul).toFixed(2);
    const durCur = weaponDurCap(kind, Math.max(1, lv));
    const durNxt = nextLv ? weaponDurCap(kind, nextLv) : durCur;

    const rows = [
        { label: '伤害',   cur: dCur,      next: dNext },
        { label: '攻速',   cur: `${cdCur}s`, next: `${cdNext}s` },
        { label: '射程',   cur: w.reach || (w.bulletSpeed ? '远程' : '-'), next: w.reach || (w.bulletSpeed ? '远程' : '-') },
        { label: '类型',   cur: w.kind === 'ranged' ? '远程' : '近战', next: w.kind === 'ranged' ? '远程' : '近战' },
        { label: '耐久上限', cur: durCur, next: durNxt },
    ];
    if (w.pellets) rows.push({ label: '散射', cur: `${w.pellets} 发`, next: `${w.pellets} 发` });
    return rows;
}
function getArmoryDesc(kind) {
    const map = {
        pistol:  '轻便的远程武器。每次点击射出一发子弹，鼠标决定方向。',
        shotgun: '一次击发 3 颗散弹壳，扇形扩散，近距离威力惊人。',
        dagger:  '短距离近战。挥砍速度快，适合灵活切入切出。',
        sword:   '长剑挥砍范围广，一击横扫多敌，攻速较慢。',
    };
    return map[kind] || '';
}

// 打开图鉴
if (btnArmory) {
    btnArmory.addEventListener('click', () => {
        renderArmory();
        showScreen('armory');
    });
}
if (btnBackArmory) {
    btnBackArmory.addEventListener('click', () => showScreen('menu'));
}

// 解锁 / 升级
if (btnWAction) {
    btnWAction.addEventListener('click', () => {
        const kind = armorySelected;
        const wm = WEAPON_META[kind];
        const owned = META.weaponFrags[kind] || 0;
        const unlocked = !!META.weapons.unlocked[kind];
        if (!unlocked) {
            if (owned < wm.unlockCost) return;
            META.weaponFrags[kind] = owned - wm.unlockCost;
            META.weapons.unlocked[kind] = true;
            META.weapons.levels[kind] = 1;
            // 首次解锁自动装备（除非已经装备了别的）
            if (!META.weapons.equipped) META.weapons.equipped = kind;
            log(`解锁武器：${WEAPONS[kind].name}`);
        } else {
            const lv = META.weapons.levels[kind] || 1;
            if (lv >= wm.maxLevel) return;
            const cost = wm.perLevel * lv;
            if (owned < cost) return;
            META.weaponFrags[kind] = owned - cost;
            META.weapons.levels[kind] = lv + 1;
            log(`${WEAPONS[kind].name} 升级到 Lv ${lv + 1}`);
        }
        saveWeapons();
        saveWeaponFrags();
        renderArmory();
    });
}

// 装备 / 卸下
if (btnWEquip) {
    btnWEquip.addEventListener('click', () => {
        const kind = armorySelected;
        if (!META.weapons.unlocked[kind]) return;
        if (META.weapons.equipped === kind) {
            META.weapons.equipped = null;
        } else {
            META.weapons.equipped = kind;
        }
        saveWeapons();
        renderArmory();
    });
}

// 调试：领取武器碎片
if (btnGiveWFrag) {
    btnGiveWFrag.addEventListener('click', () => {
        WEAPON_ORDER.forEach(k => {
            META.weaponFrags[k] = (META.weaponFrags[k] || 0) + 20;
        });
        saveWeaponFrags();
        renderArmory();
    });
}

// ============================================================
// 多人对战：房主权威 + PeerJS P2P
// ============================================================

// ---- 客人本地按键快照 ----
function mpBuildInputSnapshot() {
    return {
        left:  !!(keys['a'] || keys['arrowleft']),
        right: !!(keys['d'] || keys['arrowright']),
        up:    !!(keys['w'] || keys['arrowup']),
        down:  !!(keys['s'] || keys['arrowdown']),
        sprint:!!keys['shift'],
        guard: !!keys['e'],
        // 触发事件（jump/dash/attack/plant/selectCard/useTempCard）作为一次性 evt 消息，见下
    };
}

// 客人：每帧发送输入
let _mpLastInputSent = 0;
function mpGuestSendInput(dt) {
    if (!Net.mp.isConnected()) return;
    _mpLastInputSent += dt;
    if (_mpLastInputSent < 1 / 30) return;
    _mpLastInputSent = 0;
    Net.mp.send('input', mpBuildInputSnapshot());
}

// 客人：一次性事件上行
function mpGuestSendEvt(name, payload) {
    if (!state.mp.active || state.mp.role !== 'guest' || !Net.mp.isConnected()) return;
    Net.mp.send('evt', { name, payload });
}

// ---- 房主：应用客人输入到 dave2 ----
function mpHostApplyRemoteInput(dt) {
    const inp = state.mp.remoteInput;
    if (!inp) return;
    let vx = 0, vy = 0;
    if (inp.left)  vx -= 1;
    if (inp.right) vx += 1;
    if (inp.up)    vy -= 1;
    if (inp.down)  vy += 1;
    dave2._input = { vx, vy, sprint: !!inp.sprint, guard: !!inp.guard };
}

// ---- 房主：推进 dave2（简化版 updateDave）----
function updateDave2(dt) {
    const d = dave2;
    // CD 递减
    if (d.dashCooldown  > 0) d.dashCooldown  -= dt;
    if (d.guardCooldown > 0) d.guardCooldown -= dt;
    if (d.invuln        > 0) d.invuln        -= dt;
    if (d.perfectFlash  > 0) d.perfectFlash  -= dt;
    if (d.weaponCooldown > 0) d.weaponCooldown -= dt;
    if (d.swingTimer > 0) d.swingTimer -= dt;
    if (d.hurtFlash > 0) d.hurtFlash -= dt;
    if (d.jumpCooldown > 0) d.jumpCooldown -= dt;

    // 闪避
    if (d.dashing) {
        d.dashTimer -= dt;
        d._dashing = true;
        d.x += d.dashDir.x * ACTION.dashSpeed * dt;
        d.y += d.dashDir.y * ACTION.dashSpeed * dt;
        d.x = Math.max(FIELD.left, Math.min(FIELD.right, d.x));
        d.y = Math.max(FIELD.top + 12, Math.min(FIELD.bottom - 12, d.y));
        if (d.dashTimer <= 0) { d.dashing = false; d._dashing = false; }
        // 跳跃 & guard 计时仍然要走
        if (d.isJumping) {
            d.jumpOffset += d.vy * dt;
            d.vy -= GRAVITY * dt;
            if (d.jumpOffset <= 0) { d.jumpOffset = 0; d.vy = 0; d.isJumping = false; }
        }
        return;
    }
    d._dashing = false;

    // 格挡：受 guard 输入控制 —— 上升沿在 evt 里发起；这里只处理持续 & 计时
    if (d.guarding) {
        d.guardTimer += dt;
        if (!d._input?.guard) {
            d.guarding = false;
            d.guardCooldown = ACTION.guardCooldown;
        }
    }
    d._perfect = d.guarding && d.guardTimer <= ACTION.guardPerfectMs;

    // 常规移动
    const inp = d._input;
    let vx = inp?.vx || 0, vy = inp?.vy || 0;
    if (vx !== 0 && vy !== 0) {
        const inv = 1 / Math.SQRT2;
        vx *= inv; vy *= inv;
    }
    d.sprinting = !!inp?.sprint;
    let mul = 1;
    if (d.sprinting) mul *= 1.65;
    if (d.guarding)  mul *= 0.55;
    if (vx !== 0) {
        d.x += vx * 220 * mul * dt;
        d.facing = vx > 0 ? 1 : -1;
        d.facingAngle = Math.atan2(vy, vx);
        d.x = Math.max(FIELD.left, Math.min(FIELD.right, d.x));
    }
    if (vy !== 0) {
        d.y += vy * 180 * mul * dt;
        d.y = Math.max(FIELD.top + 12, Math.min(FIELD.bottom - 12, d.y));
    }
    // 跳跃
    if (d.isJumping) {
        d.jumpOffset += d.vy * dt;
        d.vy -= GRAVITY * dt;
        if (d.jumpOffset <= 0) { d.jumpOffset = 0; d.vy = 0; d.isJumping = false; }
    }
}

// ---- 房主：dave2 受伤 & 格挡（合并版）----
function checkDave2Damage(dt) {
    const d = dave2;
    if (d.isJumping) { d._damageAcc = 0; return; }
    if (d.invuln > 0) { d._damageAcc = 0; return; }
    for (const z of state.zombies) {
        if (z.row === d.row && Math.abs(z.x - d.x) < 25) {
            if (d.guarding) {
                d._damageAcc = 0;
                if (d._perfect && !z._stunned) {
                    z._stunTimer = ACTION.perfectStunTime;
                    z._stunned = true;
                    z.hurtFlash = 0.2;
                    d.perfectFlash = 0.35;
                    z.x += 30;
                }
                return;
            }
            d.hurtFlash = 0.15;
            d._damageAcc = (d._damageAcc || 0) + dt;
            if (d._damageAcc >= 1) {
                d._damageAcc = 0;
                d.hp--;
                d.invuln = Math.max(d.invuln, 0.6);
                if (d.hp <= 0) gameOver(false); // 双人：任意一方 0 血都败
            }
            return;
        }
    }
    d._damageAcc = 0;
}

// ---- 房主：处理来自客人的事件 ----
function mpHostHandleEvt(msg) {
    const { name, payload } = msg || {};
    const d = dave2;
    if (name === 'jump') {
        if (!d.isJumping && d.jumpCooldown <= 0) {
            d.vy = JUMP_VELOCITY;
            d.isJumping = true;
            d.jumpCooldown = JUMP_CD;
        }
    } else if (name === 'dash') {
        if (d.dashCooldown > 0 || d.dashing) return;
        const dir = payload && payload.dir;
        if (!dir) return;
        d.dashing = true;
        d.dashTimer = ACTION.dashDuration;
        d.dashDir = dir;
        d.dashCooldown = ACTION.dashCooldown;
        d.invuln = Math.max(d.invuln, ACTION.dashInvuln);
    } else if (name === 'guardStart') {
        if (d.guardCooldown > 0 || d.guarding) return;
        d.guarding = true;
        d.guardTimer = 0;
        d.guardFacing = (payload && typeof payload.face === 'number') ? payload.face : 0;
    } else if (name === 'attack') {
        // 客人的攻击方向由客人计算并发送角度
        const angle = payload?.angle ?? 0;
        mpHostFireForDave2(angle);
    }
    // 种植/选卡：暂不支持客人操作（简化）
}

// 房主：为 dave2 触发一次攻击
function mpHostFireForDave2(angle) {
    const d = dave2;
    if (d.weaponCooldown > 0) return;
    // 装备（简化）：客人默认用 dagger；后续可加协商
    const wkey = d.currentWeapon || 'dagger';
    const w = WEAPONS[wkey]; if (!w) return;
    const y = d.y - d.jumpOffset;
    d.facingAngle = angle;
    if (w.kind === 'ranged') {
        const speed = w.bulletSpeed || 500;
        const dmg = Math.round(w.damage);
        const pellets = w.pellets || 1;
        const spread = w.spread || 0;
        for (let i = 0; i < pellets; i++) {
            const t = pellets === 1 ? 0 : (i / (pellets - 1) - 0.5);
            const a = angle + t * spread;
            state.bullets.push({
                x: d.x + Math.cos(a) * 22,
                y: y + Math.sin(a) * 22,
                vx: Math.cos(a) * speed, vy: Math.sin(a) * speed,
                friendly: true, damage: dmg, color: w.color,
                label: w.bulletLabel || '·', life: 1.2,
            });
        }
    } else {
        for (const z of state.zombies) {
            const dx = z.x - d.x, dy = z.y - y;
            if (Math.hypot(dx, dy) > (w.reach || 40)) continue;
            let delta = Math.atan2(dy, dx) - angle;
            while (delta >  Math.PI) delta -= Math.PI * 2;
            while (delta < -Math.PI) delta += Math.PI * 2;
            if (Math.abs(delta) <= (w.arc || Math.PI) / 2) {
                z.hp -= w.damage;
                z.hurtFlash = 0.12;
                state.effects.push({ kind: 'hit', x: z.x, y: z.y, life: 0.15, maxLife: 0.15 });
            }
        }
    }
    d.weaponCooldown = w.fireInterval;
    d.swingTimer = 0.22; d.swingDir = angle; d.swingWeapon = wkey;
}

// ---- 房主：广播 snapshot ----
function mpHostBroadcastSnapshot() {
    // 只发必要字段，尽量小
    const snap = {
        t: state.time,
        wave: state.wave, maxWave: state.maxWave, sun: state.sun,
        waveTimer: state.waveTimer, waveActive: state.waveActive,
        gameOver: state.gameOver, victory: state.victory,
        p1: {
            x: Math.round(dave.x), y: Math.round(dave.y),
            j: Math.round(dave.jumpOffset), hp: dave.hp,
            f: dave.facing, fa: +dave.facingAngle.toFixed(2),
            hf: dave.hurtFlash > 0 ? 1 : 0,
            gd: dave.guarding ? 1 : 0,
            gf: +(dave.guardFacing || 0).toFixed(2),
            gp: inPerfectGuard() ? 1 : 0,
            dx: dave.dashing ? 1 : 0,
            sw: dave.swingTimer > 0 ? 1 : 0,
            swD: +dave.swingDir.toFixed(2), swW: dave.swingWeapon,
            jp: dave.isJumping ? 1 : 0,
        },
        p2: {
            x: Math.round(dave2.x), y: Math.round(dave2.y),
            j: Math.round(dave2.jumpOffset), hp: dave2.hp,
            hf: dave2.hurtFlash > 0 ? 1 : 0,
            gd: dave2.guarding ? 1 : 0,
            gp: dave2._perfect ? 1 : 0,
            dx: dave2.dashing ? 1 : 0,
            sw: dave2.swingTimer > 0 ? 1 : 0,
            swD: +(dave2.swingDir || 0).toFixed(2),
            jp: dave2.isJumping ? 1 : 0,
        },
        zs: state.zombies.map(z => ({
            k: z.kind, x: Math.round(z.x), y: Math.round(z.y),
            hp: Math.round(z.hp), mhp: Math.round(z.maxHp),
            hf: z.hurtFlash > 0 ? 1 : 0,
        })),
        bs: state.bullets.map(b => ({
            x: Math.round(b.x), y: Math.round(b.y),
            l: b.label, c: b.color, e: b.enemy ? 1 : 0,
        })),
        pl: state.plants.map(p => ({
            k: p.kind, x: Math.round(p.x), y: Math.round(p.y),
        })),
        su: state.suns.map(s => ({ x: Math.round(s.x), y: Math.round(s.y) })),
        pk: state.pickups.map(p => ({ k: p.kind, x: Math.round(p.x), y: Math.round(p.y), a: p.amount })),
    };
    Net.mp.send('snap', snap);
}

// ---- 客人：应用 snapshot 到本地 state（用于渲染）----
function mpGuestApplySnapshot(snap) {
    state.wave = snap.wave; state.maxWave = snap.maxWave;
    state.sun = snap.sun; state.waveTimer = snap.waveTimer;
    state.waveActive = snap.waveActive;
    if (snap.gameOver && !state.gameOver) {
        state.gameOver = true; state.victory = !!snap.victory;
    }
    // P1 = 房主的戴夫 → 用 dave2 显示（客人本身是 P2 = dave）
    if (snap.p1) {
        dave2.x = snap.p1.x; dave2.y = snap.p1.y;
        dave2.jumpOffset = snap.p1.j; dave2.hp = snap.p1.hp;
        dave2.facing = snap.p1.f; dave2.facingAngle = snap.p1.fa;
        dave2.hurtFlash = snap.p1.hf ? 0.15 : 0;
        dave2.guarding = !!snap.p1.gd; dave2.guardFacing = snap.p1.gf;
        dave2._perfect = !!snap.p1.gp;
        dave2._dashing = !!snap.p1.dx;
        dave2.isJumping = !!snap.p1.jp;
        dave2.swingTimer = snap.p1.sw ? 0.22 : 0;
        dave2.swingDir = snap.p1.swD || 0; dave2.swingWeapon = snap.p1.swW;
        dave2.label = 'P1';
        dave2.color = '#00FF88';
    }
    // P2 = 客人自身 → 用 dave（覆盖位置以对齐权威）
    if (snap.p2) {
        dave.x = snap.p2.x; dave.y = snap.p2.y;
        dave.jumpOffset = snap.p2.j; dave.hp = snap.p2.hp;
        dave.hurtFlash = snap.p2.hf ? 0.15 : Math.max(0, dave.hurtFlash - 0.02);
        dave.guarding = !!snap.p2.gd;
        dave.isJumping = !!snap.p2.jp;
        dave.dashing = !!snap.p2.dx;
        dave.swingTimer = snap.p2.sw ? 0.22 : 0;
        dave.swingDir = snap.p2.swD || 0;
        dave.label = 'P2';
        dave.color = '#66FFCC';
    }
    // 重建僵尸、子弹、植物、阳光、拾取（简单粗暴：整表替换用于渲染）
    state.zombies = (snap.zs || []).map(z => ({
        kind: z.k, x: z.x, y: z.y, row: yToRow(z.y),
        hp: z.hp, maxHp: z.mhp, hurtFlash: z.hf ? 0.12 : 0,
        speed: 0, // 客人不推进
    }));
    state.bullets = (snap.bs || []).map(b => ({
        x: b.x, y: b.y, vx: 0, vy: 0, label: b.l, color: b.c,
        enemy: !!b.e, friendly: !b.e, damage: 0, row: null,
    }));
    state.plants = (snap.pl || []).map(p => ({
        kind: p.k, x: p.x, y: p.y, row: yToRow(p.y),
        hp: 999, mul: 1, produceTimer: 999, fireTimer: 999, fuseTimer: 999, shake: 0,
    }));
    state.suns = (snap.su || []).map(s => ({ x: s.x, y: s.y, targetY: s.y, vy: 0, value: 25, life: 10 }));
    state.pickups = (snap.pk || []).map(p => ({
        kind: p.k, x: p.x, y: p.y, amount: p.a || 1, vy: 0, life: 12, hopPhase: 0, extra: null,
    }));
}

// ---- 主菜单 · 多人按钮 ----
const mpModal   = document.getElementById('mp-modal');
const btnMp     = document.getElementById('btn-multiplayer');
const btnMpClose= document.getElementById('mp-close');
const btnMpHost = document.getElementById('mp-host-btn');
const btnMpJoin = document.getElementById('mp-join-btn');
const btnMpStart= document.getElementById('mp-start');
const btnMpCopy = document.getElementById('mp-copy');
const mpCodeEl  = document.getElementById('mp-room-code');
const mpInfoEl  = document.getElementById('mp-room-info');
const mpInputEl = document.getElementById('mp-code-input');
const mpStatusEl= document.getElementById('mp-status');
const mpTabs    = document.querySelectorAll('.mp-tab');
const mpPanels  = document.querySelectorAll('.mp-panel');

function setMpStatus(text, cls) {
    if (!mpStatusEl) return;
    mpStatusEl.textContent = text;
    mpStatusEl.className = 'mp-status ' + (cls || '');
}

if (btnMp) {
    btnMp.addEventListener('click', () => {
        mpModal.classList.remove('hidden');
        setMpStatus('未连接');
        btnMpStart.classList.add('hidden');
        mpInfoEl.classList.add('hidden');
    });
}
if (btnMpClose) {
    btnMpClose.addEventListener('click', () => {
        mpModal.classList.add('hidden');
        if (!Net.mp.isConnected() && !state.mp.active) Net.mp.close(true);
    });
}
mpTabs.forEach(t => t.addEventListener('click', () => {
    const tab = t.dataset.tab;
    mpTabs.forEach(x => x.classList.toggle('active', x === t));
    mpPanels.forEach(p => p.classList.toggle('hidden', p.dataset.panel !== tab));
}));

if (btnMpHost) {
    btnMpHost.addEventListener('click', async () => {
        setMpStatus('创建中...', 'wait');
        btnMpHost.disabled = true;
        const r = await Net.mp.host();
        btnMpHost.disabled = false;
        if (!r.ok) { setMpStatus('创建失败：' + r.error, 'err'); return; }
        mpCodeEl.textContent = r.code;
        mpInfoEl.classList.remove('hidden');
        setMpStatus('等待好友加入... (房间码：' + r.code + ')', 'wait');
    });
}
if (btnMpCopy) {
    btnMpCopy.addEventListener('click', () => {
        const code = mpCodeEl.textContent;
        if (!code || code === '------') return;
        try {
            navigator.clipboard.writeText(code);
            btnMpCopy.textContent = '已复制';
            setTimeout(() => btnMpCopy.textContent = '复制', 1200);
        } catch {}
    });
}
if (btnMpJoin) {
    btnMpJoin.addEventListener('click', async () => {
        const code = (mpInputEl.value || '').toUpperCase().trim();
        if (!code) return;
        setMpStatus('连接房主...', 'wait');
        btnMpJoin.disabled = true;
        const r = await Net.mp.join(code);
        btnMpJoin.disabled = false;
        if (!r.ok) { setMpStatus('加入失败：' + r.error, 'err'); return; }
        setMpStatus('已连接，等待房主开始...', 'ok');
    });
}
if (btnMpStart) {
    btnMpStart.addEventListener('click', () => {
        if (!Net.mp.isHost() || !Net.mp.isConnected()) return;
        mpModal.classList.add('hidden');
        // 房主开局：默认第一关（或最后一次进过的关）
        const lastId = saveData.lastLevel;
        const lv = LEVELS.find(l => l.id === lastId) || LEVELS[0];
        state.mp.active = true;
        state.mp.role = 'host';
        Net.mp.send('start', { levelId: lv.id });
        startGame(lv);
    });
}

// PeerJS 事件监听
if (window.Net && Net.mp) {
    Net.mp.on('status', (s) => {
        if (s.status === 'connected') {
            if (Net.mp.isHost()) {
                setMpStatus('★ 好友已加入！房主可开始游戏', 'ok');
                btnMpStart.classList.remove('hidden');
            } else {
                setMpStatus('★ 已加入房间，等待房主开始...', 'ok');
            }
        } else if (s.status === 'closed') {
            if (state.mp.active) {
                log('联机连接已断开，回到主菜单');
                state.mp.active = false;
                state.mp.role = null;
                stopGame();
                showScreen('menu');
            } else {
                setMpStatus('连接已关闭');
                btnMpStart.classList.add('hidden');
            }
        } else if (s.status === 'error') {
            setMpStatus('错误：' + s.error, 'err');
        }
    });

    // 客人：收到房主开局广播
    Net.mp.on('start', (d) => {
        if (!Net.mp.isGuest()) return;
        state.mp.active = true;
        state.mp.role = 'guest';
        const lv = LEVELS.find(l => l.id === d.levelId) || LEVELS[0];
        mpModal.classList.add('hidden');
        startGame(lv);
        // 覆盖客人本地的分工：客人是 P2
        dave.label = 'P2'; dave.color = '#66FFCC';
    });

    // 房主：收到客人输入 / 事件
    Net.mp.on('input', (d) => {
        if (!Net.mp.isHost() || !state.mp.active) return;
        state.mp.remoteInput = d;
    });
    Net.mp.on('evt', (d) => {
        if (!Net.mp.isHost() || !state.mp.active) return;
        mpHostHandleEvt(d);
    });

    // 客人：收到 snapshot
    Net.mp.on('snap', (d) => {
        if (!Net.mp.isGuest() || !state.mp.active) return;
        mpGuestApplySnapshot(d);
    });
}

// ---- 客人：捕获本地事件并上行 ----
// 拦截 keydown 里的一次性动作 & 鼠标攻击
window.addEventListener('keydown', (e) => {
    if (!state.mp.active || state.mp.role !== 'guest') return;
    if (inputFocused) return;
    const k = e.key.toLowerCase();
    if (k === ' ')       mpGuestSendEvt('jump');
    else if (k === 'q')  mpGuestSendEvt('dash', { dir: currentMoveDir() });
    else if (k === 'e')  {
        const daveY = dave.y - dave.jumpOffset;
        const face = mouse.inside
            ? Math.atan2(mouse.y - daveY, mouse.x - dave.x)
            : (dave.facing > 0 ? 0 : Math.PI);
        mpGuestSendEvt('guardStart', { face });
    }
}, true);

// 客人：左键攻击 → 上行角度（不本地执行）
canvas.addEventListener('mousedown', (e) => {
    if (e.button !== 0) return;
    if (!state.mp.active || state.mp.role !== 'guest') return;
    const daveY = dave.y - dave.jumpOffset;
    const angle = mouse.inside
        ? Math.atan2(mouse.y - daveY, mouse.x - dave.x)
        : (dave.facing > 0 ? 0 : Math.PI);
    mpGuestSendEvt('attack', { angle });
}, true);
